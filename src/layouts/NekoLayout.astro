---
/**
 * 全站布局 —— 樱花柔光主题
 * 保留原有能力：BGM 播放器（iframe 不中断）、图片灯箱、樱花飘落、滚动揭示
 */
import '../styles/theme.css';

interface Props {
  title: string;
  description?: string;
  /** 当前页面对应的导航项，用于高亮 */
  active?: 'home' | 'posts' | 'gallery' | 'library' | 'tutorial' | 'about';
}

const {
  title,
  description = '樱风工房 —— Radiozed 的嵌入式驱动笔记：模块驱动源码、接线图、初始化流程与最小 Demo。',
  active = '',
} = Astro.props;

const navItems = [
  { key: 'home', label: '首页', href: '/' },
  { key: 'library', label: '驱动库', href: '/#library' },
  { key: 'tutorial', label: '上手教程', href: '/#tutorial' },
  { key: 'posts', label: '全部文章', href: '/posts' },
  { key: 'tools', label: '串口工具', href: '/serial/' },
  { key: 'gallery', label: '画廊', href: '/gallery' },
  { key: 'about', label: '关于我', href: '/#about' },
];
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#FDF5FA" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <link
    rel="icon"
    type="image/svg+xml"
    href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Ccircle cx='20' cy='20' r='19' fill='%23FDE7F0'/%3E%3Cg fill='%23F389AE'%3E%3Cellipse cx='20' cy='12' rx='4.6' ry='5.8'/%3E%3Cellipse cx='20' cy='12' rx='4.6' ry='5.8' transform='rotate(72 20 20)'/%3E%3Cellipse cx='20' cy='12' rx='4.6' ry='5.8' transform='rotate(144 20 20)'/%3E%3Cellipse cx='20' cy='12' rx='4.6' ry='5.8' transform='rotate(216 20 20)'/%3E%3Cellipse cx='20' cy='12' rx='4.6' ry='5.8' transform='rotate(288 20 20)'/%3E%3C/g%3E%3Ccircle cx='20' cy='20' r='3.2' fill='%23E4668F'/%3E%3C/svg%3E"
  />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;500;700&display=swap"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/manrope@5/500.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/manrope@5/700.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/manrope@5/800.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/jetbrains-mono@5/400.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/jetbrains-mono@5/700.css" />
</head>
<body>
  <a class="skip-link" href="#main">跳到主要内容</a>

  <!-- ── 顶部导航 ── -->
  <header class="site-header" id="siteHeader">
    <div class="nav-inner">
      <a class="brand" href="/" aria-label="樱风工房 首页">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 40 40" width="40" height="40">
            <circle cx="20" cy="20" r="19" fill="var(--pink-soft)"></circle>
            <g fill="var(--pink)">
              <ellipse cx="20" cy="12" rx="4.6" ry="5.8"></ellipse>
              <ellipse cx="20" cy="12" rx="4.6" ry="5.8" transform="rotate(72 20 20)"></ellipse>
              <ellipse cx="20" cy="12" rx="4.6" ry="5.8" transform="rotate(144 20 20)"></ellipse>
              <ellipse cx="20" cy="12" rx="4.6" ry="5.8" transform="rotate(216 20 20)"></ellipse>
              <ellipse cx="20" cy="12" rx="4.6" ry="5.8" transform="rotate(288 20 20)"></ellipse>
            </g>
            <circle cx="20" cy="20" r="3.2" fill="var(--pink-deep)"></circle>
          </svg>
        </span>
        <span class="brand-text">
          <span class="brand-name">樱风工房</span>
          <span class="brand-sub">SAKUKAZE LAB</span>
        </span>
      </a>

      <nav class="nav-links" id="navLinks" aria-label="主导航">
        {navItems.map((item) => (
          <a href={item.href} class:list={['nav-link', { 'is-active': active === item.key }]}>
            {item.label}
          </a>
        ))}
      </nav>

      <div class="nav-actions">
        <a class="btn btn-primary btn-sm" href="/posts">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" aria-hidden="true">
            <path
              d="M12 3l2.6 5.7 6.2.7-4.6 4.2 1.3 6.1L12 16.8 6.5 19.7l1.3-6.1L3.2 9.4l6.2-.7L12 3Z"
              stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
          </svg>
          开始阅读
        </a>
        <button
          class="icon-btn menu-btn"
          id="menuBtn"
          type="button"
          aria-label="打开菜单"
          aria-expanded="false"
          aria-controls="navLinks"
        >
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <!-- ── 页脚 ── -->
  <footer class="site-footer">
    <div class="footer-sky" aria-hidden="true">
      <svg viewBox="0 0 1440 420" preserveAspectRatio="xMidYMid slice">
        <circle cx="1236" cy="88" r="46" fill="#FFF3F8" opacity=".9"></circle>
        <circle cx="1219" cy="77" r="42" fill="var(--night-from)"></circle>
        <g fill="#fff">
          <circle cx="120" cy="60" r="2" opacity=".55"></circle><circle cx="268" cy="122" r="1.4" opacity=".4"></circle>
          <circle cx="402" cy="48" r="2.2" opacity=".6"></circle><circle cx="548" cy="140" r="1.5" opacity=".35"></circle>
          <circle cx="690" cy="72" r="1.8" opacity=".5"></circle><circle cx="836" cy="130" r="1.3" opacity=".35"></circle>
          <circle cx="968" cy="56" r="2" opacity=".55"></circle><circle cx="1094" cy="160" r="1.6" opacity=".4"></circle>
          <circle cx="1332" cy="230" r="1.7" opacity=".45"></circle><circle cx="176" cy="248" r="1.4" opacity=".3"></circle>
          <circle cx="628" cy="226" r="1.9" opacity=".4"></circle><circle cx="1046" cy="300" r="1.5" opacity=".3"></circle>
        </g>
        <g fill="#F7A8C6">
          <path d="M300 196c3.4 2.9 5.1 5.9 5.1 8.9a5.1 5.1 0 0 1-10.2 0c0-3 1.7-6 5.1-8.9Z" opacity=".75"></path>
          <path d="M892 178c2.9 2.5 4.3 5 4.3 7.6a4.3 4.3 0 0 1-8.6 0c0-2.6 1.4-5.1 4.3-7.6Z" opacity=".6"></path>
          <path d="M512 96c2.6 2.2 3.9 4.5 3.9 6.8a3.9 3.9 0 0 1-7.8 0c0-2.3 1.3-4.6 3.9-6.8Z" opacity=".5"></path>
        </g>
      </svg>
    </div>
    <span class="footer-glow" aria-hidden="true"></span>

    <div class="wrap footer-inner">
      <div class="footer-top">
        <div class="footer-brand">
          <span class="footer-logo">
            <svg viewBox="0 0 40 40" width="38" height="38" aria-hidden="true">
              <circle cx="20" cy="20" r="19" fill="var(--pink)"></circle>
              <g fill="#fff">
                <ellipse cx="20" cy="12" rx="4.6" ry="5.8"></ellipse>
                <ellipse cx="20" cy="12" rx="4.6" ry="5.8" transform="rotate(72 20 20)"></ellipse>
                <ellipse cx="20" cy="12" rx="4.6" ry="5.8" transform="rotate(144 20 20)"></ellipse>
                <ellipse cx="20" cy="12" rx="4.6" ry="5.8" transform="rotate(216 20 20)"></ellipse>
                <ellipse cx="20" cy="12" rx="4.6" ry="5.8" transform="rotate(288 20 20)"></ellipse>
              </g>
              <circle cx="20" cy="20" r="3.2" fill="var(--pink-deep)"></circle>
            </svg>
            <span>樱风工房</span>
          </span>
          <p class="footer-tag">
            记录每一颗芯片的脾气与解法。源码、接线图、踩坑记录，长期更新。
          </p>
          <div class="socials">
            <a class="social" href="https://github.com/Radiozed" target="_blank" rel="noopener" aria-label="GitHub">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" aria-hidden="true">
                <path
                  d="M9.5 21v-3.2c-3 .6-3.7-1.4-3.7-1.4-.5-1.2-1.2-1.6-1.2-1.6-1-.7.1-.7.1-.7 1.1.1 1.7 1.1 1.7 1.1 1 1.7 2.6 1.2 3.2.9.1-.7.4-1.2.7-1.5-2.5-.3-5.1-1.2-5.1-5.5 0-1.2.4-2.2 1.1-3-.1-.3-.5-1.4.1-2.9 0 0 .9-.3 3.1 1.1a10.6 10.6 0 0 1 5.6 0c2.2-1.4 3.1-1.1 3.1-1.1.6 1.5.2 2.6.1 2.9.7.8 1.1 1.8 1.1 3 0 4.3-2.6 5.2-5.1 5.5.4.4.8 1.1.8 2.2V21"
                  stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
            <a class="social" href="/posts" aria-label="全部文章">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" aria-hidden="true">
                <rect x="4" y="3" width="16" height="18" rx="3" stroke="currentColor" stroke-width="1.7"></rect>
                <path d="M8 8h8M8 12h8M8 16h5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
              </svg>
            </a>
            <a class="social" href="/gallery" aria-label="画廊">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" aria-hidden="true">
                <rect x="3" y="4" width="18" height="16" rx="3" stroke="currentColor" stroke-width="1.7"></rect>
                <circle cx="9" cy="10" r="2" fill="currentColor"></circle>
                <path d="M5 18l5-4.5 3.5 3L17 13l2 2.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
          </div>
        </div>

        <nav class="footer-col" aria-label="驱动笔记">
          <h3>驱动笔记</h3>
          <a href="/posts">全部文章</a>
          <a href="/#library">驱动库</a>
          <a href="/#tutorial">接线与踩坑</a>
        </nav>
        <nav class="footer-col" aria-label="内容">
          <h3>内容</h3>
          <a href="/gallery">画作画廊</a>
          <a href="/posts/hello-world">第一篇博客</a>
          <a href="/posts/max31865-pt100">MAX31865 + PT100</a>
        </nav>
        <nav class="footer-col" aria-label="关于">
          <h3>关于</h3>
          <a href="/#about">关于我</a>
          <a href="https://github.com/Radiozed" target="_blank" rel="noopener">GitHub</a>
          <a href="/posts">联系我</a>
        </nav>
      </div>

      <hr class="footer-rule" />

      <div class="footer-bottom">
        <p>Copyright {new Date().getFullYear()} 樱风工房 SAKUKAZE LAB · Radiozed</p>
        <p class="footer-sign">Built on a messy desk, powered by J-Link</p>
      </div>
    </div>
  </footer>

  <!-- ── BGM：iframe 保持跨页播放不中断 ── -->
  <iframe
    id="bgmFrame"
    src="/player.html"
    title="背景音乐播放器"
    style="position:fixed;bottom:0;left:0;width:1px;height:1px;border:none;opacity:0;pointer-events:none;"
    allow="autoplay"></iframe>

  <button type="button" class="music-toggle" id="musicToggle" title="背景音乐" aria-label="背景音乐开关">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true">
      <path d="M9 18V6l10-2v12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
      <circle cx="6.5" cy="18" r="2.5" stroke="currentColor" stroke-width="1.8"></circle>
      <circle cx="16.5" cy="16" r="2.5" stroke="currentColor" stroke-width="1.8"></circle>
    </svg>
  </button>

  <!-- ── 图片灯箱 ── -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="图片查看">
    <button class="lightbox-close" id="lightboxClose" aria-label="关闭">✕</button>
    <img class="lightbox-img" id="lightboxImg" src="" alt="" />
  </div>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script>
    var $ = function (sel) { return document.querySelector(sel); };
    var $$ = function (sel) { return document.querySelectorAll(sel); };

    /* ── 导航：滚动阴影 ── */
    var header = $('#siteHeader');
    function onScroll() {
      if (header) header.classList.toggle('is-scrolled', window.scrollY > 8);
    }
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    /* ── 移动端抽屉 ── */
    var menuBtn = $('#menuBtn');
    var navLinks = $('#navLinks');
    if (menuBtn && navLinks) {
      menuBtn.addEventListener('click', function () {
        var open = navLinks.classList.toggle('is-open');
        menuBtn.setAttribute('aria-expanded', String(open));
      });
      navLinks.addEventListener('click', function (e) {
        if (e.target.closest('a')) {
          navLinks.classList.remove('is-open');
          menuBtn.setAttribute('aria-expanded', 'false');
        }
      });
    }

    /* ── 滚动揭示 ── */
    var revealTargets = $$('.reveal, .fade-in');
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            entry.target.classList.add(
              entry.target.classList.contains('fade-in') ? 'visible' : 'is-in'
            );
            io.unobserve(entry.target);
          });
        },
        { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
      );
      revealTargets.forEach(function (el) { io.observe(el); });
    } else {
      revealTargets.forEach(function (el) { el.classList.add('is-in', 'visible'); });
    }

    /* ── 樱花飘落 ── */
    (function sakura() {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var container = document.createElement('div');
      container.className = 'sakura-container';
      container.setAttribute('aria-hidden', 'true');
      document.body.appendChild(container);

      function spawn() {
        var petal = document.createElement('span');
        petal.className = 'sakura-petal';
        var size = Math.random() * 8 + 9;
        petal.style.left = Math.random() * 100 + 'vw';
        petal.style.width = size + 'px';
        petal.style.height = size + 'px';
        petal.style.animationDuration = Math.random() * 6 + 9 + 's';
        petal.style.opacity = String(Math.random() * 0.35 + 0.3);
        petal.style.background = Math.random() > 0.5 ? 'var(--pink)' : 'var(--lavender)';
        container.appendChild(petal);
        setTimeout(function () { petal.remove(); }, 15000);
      }
      for (var i = 0; i < 5; i++) setTimeout(spawn, i * 900);
      setInterval(spawn, 1600);
    })();

    /* ── 提示条 ── */
    var toastTimer;
    function toast(msg) {
      var el = $('#toast');
      if (!el) return;
      el.textContent = msg;
      el.classList.add('is-on');
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(function () { el.classList.remove('is-on'); }, 2200);
    }
    window.__toast = toast;

    /* ── 代码块复制 ── */
    $$('[data-copy]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var scope = btn.closest('.code-window') || btn.closest('.code-wrapper');
        var code = scope && scope.querySelector('code');
        if (!code) return;
        navigator.clipboard.writeText(code.textContent || '').then(function () {
          var original = btn.textContent;
          btn.textContent = '已复制';
          btn.classList.add('is-done');
          setTimeout(function () {
            btn.textContent = original;
            btn.classList.remove('is-done');
          }, 1800);
        }).catch(function () { toast('复制失败，手动选一下吧'); });
      });
    });

    /* ── 图片灯箱 ── */
    (function lightbox() {
      var box = $('#lightbox');
      var img = $('#lightboxImg');
      var close = $('#lightboxClose');
      if (!box || !img) return;

      function open(src, alt) {
        img.src = src;
        img.alt = alt || '';
        box.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
      function hide() {
        box.classList.remove('active');
        document.body.style.overflow = '';
      }

      $$('.gallery-item img, [data-lightbox]').forEach(function (el) {
        el.style.cursor = 'zoom-in';
        el.addEventListener('click', function () {
          open(el.currentSrc || el.src, el.alt);
        });
      });
      if (close) close.addEventListener('click', hide);
      box.addEventListener('click', function (e) { if (e.target === box) hide(); });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && box.classList.contains('active')) hide();
      });
    })();

    /* ── BGM：通过 postMessage 控制 iframe 里的播放器，跨页不中断 ── */
    (function bgm() {
      var toggle = $('#musicToggle');
      var frame = $('#bgmFrame');
      if (!toggle || !frame) return;

      var playing = localStorage.getItem('bgmAutoPlay') === 'true';

      function paint() { toggle.classList.toggle('off', !playing); }
      function post(action) {
        try {
          if (frame.contentWindow) frame.contentWindow.postMessage(action, '*');
        } catch (err) { /* 未就绪，忽略 */ }
      }
      function send(action) {
        post(action);
        frame.addEventListener('load', function () { post(action); }, { once: true });
      }

      paint();
      if (playing) send('play');

      toggle.addEventListener('click', function () {
        playing = !playing;
        localStorage.setItem('bgmAutoPlay', String(playing));
        paint();
        send(playing ? 'play' : 'pause');
      });

      window.addEventListener('message', function (e) {
        if (e.data === 'playing' || e.data === 'paused') {
          playing = e.data === 'playing';
          localStorage.setItem('bgmAutoPlay', String(playing));
          paint();
        }
      });
    })();
  </script>
</body>
</html>
