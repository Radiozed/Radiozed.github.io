---
import { getCollection } from 'astro:content';
import NekoLayout from '../../layouts/NekoLayout.astro';
import { platformOf, categoryOf, busOf, tintOf, shortDate, uniqBy } from '../../lib/classify';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const rows = posts.map((p) => ({
  slug: p.slug,
  title: p.data.title,
  description: p.data.description,
  pubDate: p.data.pubDate,
  tags: p.data.tags ?? [],
  platform: platformOf(p.data),
  category: categoryOf(p.data),
  bus: busOf(p.data),
  difficulty: p.data.difficulty ?? '进阶',
}));

const categories = uniqBy(rows.map((r) => r.category), 'category');
const countIn = (c: string) => rows.filter((r) => r.category === c).length;
---

<NekoLayout
  title="全部文章 · 樱风工房"
  description="樱风工房的全部驱动笔记与随笔，按平台与类别整理。"
  active="posts"
>
  <section class="posts-page wrap">
    <header class="page-head">
      <p class="eyebrow">POSTS · 共 {rows.length} 篇</p>
      <h1 class="page-title">全部文章</h1>
      <p class="page-subtitle">驱动笔记、踩坑记录，还有一些随手写的东西。</p>
    </header>

    <div class="filter-row" data-group="category">
      <span class="filter-label">类别</span>
      <button class="chip is-active" type="button" data-value="all" aria-pressed="true">
        全部 <em>{rows.length}</em>
      </button>
      {categories.map((c) => (
        <button class="chip" type="button" data-value={c} aria-pressed="false">
          {c} <em>{countIn(c)}</em>
        </button>
      ))}
    </div>

    <div class="posts-list" id="postsList">
      {rows.map((post, i) => (
        <a class="post-row reveal" href={`/posts/${post.slug}`} data-category={post.category}>
          <span class="post-index">{String(i + 1).padStart(2, '0')}</span>

          <span class:list={['post-bus', tintOf(post.category)]}>{post.bus}</span>

          <div class="post-main">
            <h2 class="post-row-title">{post.title}</h2>
            <p class="post-row-desc">{post.description}</p>
          </div>

          <div class="post-side">
            <div class="post-tags">
              <span class="tag tag-platform">{post.platform} · {post.category}</span>
              <span class="tag tag-level">{post.difficulty}</span>
            </div>
            <time class="post-date" datetime={post.pubDate.toISOString()}>
              {post.pubDate.toLocaleDateString('zh-CN')} · {shortDate(post.pubDate)}
            </time>
          </div>

          <svg class="post-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
            <path d="M5 12h13M12.5 5.5L19 12l-6.5 6.5" stroke="var(--pink-deep)" stroke-width="2.2"
                  stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      ))}
    </div>

    <p class="grid-empty" id="postsEmpty" hidden>这个类别下还没有文章，再等等我。</p>

    <div class="center-row">
      <a class="back-link" href="/">← 返回首页</a>
    </div>
  </section>

  <script>
    (function categoryFilter() {
      var row = document.querySelector('.filter-row[data-group="category"]');
      var list = document.querySelectorAll('#postsList .post-row');
      var empty = document.getElementById('postsEmpty');
      if (!row || !list.length) return;

      row.addEventListener('click', function (e) {
        var chip = e.target.closest('.chip');
        if (!chip) return;
        var value = chip.dataset.value;

        row.querySelectorAll('.chip').forEach(function (c) {
          var on = c === chip;
          c.classList.toggle('is-active', on);
          c.setAttribute('aria-pressed', String(on));
        });

        var shown = 0;
        list.forEach(function (item) {
          var ok = value === 'all' || item.dataset.category === value;
          item.classList.toggle('is-hidden', !ok);
          if (ok) shown++;
        });
        if (empty) empty.hidden = shown > 0;
      });
    })();
  </script>
</NekoLayout>

<style>
  .posts-page { padding-bottom: 96px; }

  .filter-row {
    display: flex; flex-wrap: wrap; align-items: center; gap: 8px;
    margin-bottom: 28px;
  }
  .filter-label {
    flex: none; min-width: 38px;
    font-family: var(--font-latin); font-size: 12px; font-weight: 800;
    letter-spacing: .14em; color: var(--ink-3);
  }

  .posts-list { display: flex; flex-direction: column; gap: 14px; }

  .post-row {
    display: grid;
    grid-template-columns: 52px 58px minmax(0, 1fr) auto 18px;
    align-items: center; gap: 20px;
    padding: 20px 26px; border-radius: 22px;
    background: var(--surface); border: 1px solid var(--line);
    box-shadow: var(--sh-card);
    transition: transform .25s cubic-bezier(.2, .8, .3, 1), box-shadow .25s ease,
                border-color .25s ease, opacity .2s ease;
  }
  .post-row:hover {
    transform: translateY(-4px);
    box-shadow: var(--sh-card-hover);
    border-color: rgba(243, 137, 174, .4);
  }
  .post-row.is-hidden { display: none; }

  .post-index {
    font-family: var(--font-latin); font-size: 22px; font-weight: 800;
    color: var(--pink-soft); line-height: 1;
  }

  .post-bus {
    display: grid; place-items: center;
    width: 58px; height: 44px; border-radius: 14px;
    font-family: var(--font-mono); font-size: 12px; font-weight: 700; color: #fff;
  }

  .post-main { min-width: 0; }
  .post-row-title { margin: 0 0 6px; font-size: 17px; font-weight: 700; line-height: 1.5; }
  .post-row-desc {
    margin: 0; font-size: 13px; line-height: 1.6; color: var(--ink-2);
    display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2;
    -webkit-box-orient: vertical; overflow: hidden;
  }

  .post-side { display: flex; flex-direction: column; align-items: flex-end; gap: 10px; }
  .post-tags { display: flex; flex-wrap: wrap; gap: 6px; justify-content: flex-end; }
  .post-tags .tag { font-size: 10px; padding: 4px 10px; }
  .tag-level { background: var(--pink-soft); color: var(--pink-deep); font-family: var(--font-sans); }
  .post-date {
    font-family: var(--font-latin); font-size: 12px; font-weight: 500;
    color: var(--ink-3); white-space: nowrap;
  }

  .post-arrow { transition: transform .22s ease; }
  .post-row:hover .post-arrow { transform: translateX(4px); }

  .grid-empty { padding: 48px 0 8px; text-align: center; color: var(--ink-3); font-size: 14px; }
  .center-row { display: flex; justify-content: center; margin-top: 52px; }

  @media (max-width: 900px) {
    .post-row { grid-template-columns: 40px minmax(0, 1fr) 18px; gap: 16px; padding: 20px; }
    .post-bus, .post-side { display: none; }
    .post-index { font-size: 18px; }
  }
</style>
