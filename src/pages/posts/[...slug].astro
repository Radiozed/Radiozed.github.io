---
import { getCollection } from 'astro:content';
import NekoLayout from '../../layouts/NekoLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const sorted = [...posts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  /* 侧栏日历要用：所有文章的日期索引，用来标记哪几天有更新 */
  const archive = sorted.map((p) => ({
    slug: p.slug,
    title: p.data.title,
    date: p.data.pubDate.toISOString().slice(0, 10),
  }));

  return sorted.map((post, i) => ({
    params: { slug: post.slug },
    props: {
      post,
      archive,
      prev: sorted[i + 1] ?? null,
      next: sorted[i - 1] ?? null,
    },
  }));
}

const { post, prev, next, archive } = Astro.props;
const { Content, headings } = await post.render();

/* 目录：只取二三级标题，避免侧栏过长 */
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

/* 正文字数（去 Markdown 标记的粗略统计） */
const wordCount = (post.body ?? '')
  .replace(/```[\s\S]*?```/g, '')
  .replace(/[#>*`\-|\[\]()]/g, '')
  .replace(/\s/g, '').length;

const readMinutes = Math.max(1, Math.round(wordCount / 400));
---

<NekoLayout title={`${post.data.title} · 樱风工房`} description={post.data.description} active="posts">
  <div class="post-layout wrap">
    <!-- ── 侧栏 ── -->
    <aside class="post-sidebar">
      {toc.length > 0 && (
        <nav class="panel panel-tight sidebar-toc" aria-label="文章目录">
          <div class="toc-header">目录 <em>{toc.length}</em></div>
          <div class="toc-list">
            {toc.map((h) => (
              <a class:list={['toc-item', { 'is-sub': h.depth === 3 }]} href={`#${h.slug}`}>{h.text}</a>
            ))}
          </div>
        </nav>
      )}

      <div class="panel panel-tight sidebar-info">
        <div class="info-row">
          <span class="info-label">约</span>
          <span class="info-value">{wordCount} 字</span>
        </div>
        <div class="info-row">
          <span class="info-label">阅读</span>
          <span class="info-value">{readMinutes} 分钟</span>
        </div>
        <div class="info-row">
          <span class="info-label">发布</span>
          <span class="info-value">{post.data.pubDate.toLocaleDateString('zh-CN')}</span>
        </div>
      </div>

      <!-- 更新日历：有文章的日期会标出来，点一下直接跳过去 -->
      <!-- 注意：侧栏是滚动容器，这里不能用 .reveal，否则 IntersectionObserver 被 overflow 裁剪，面板会一直 opacity:0 -->
      <div
        class="panel panel-tight sidebar-cal"
        id="calendarPanel"
        data-archive={JSON.stringify(archive)}
      >
        <div class="cal-head">
          <span class="cal-title" id="calendar-title">—</span>
          <div class="cal-actions">
            <button class="cal-nav" id="prev-month-btn" type="button" aria-label="上个月">‹</button>
            <button class="cal-today" id="cal-today-btn" type="button">今天</button>
            <button class="cal-nav" id="next-month-btn" type="button" aria-label="下个月">›</button>
          </div>
        </div>
        <div class="cal-week"><span>日</span><span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span>六</span></div>
        <div class="cal-days" id="calendar-days"></div>
        <p class="cal-foot" id="calendar-foot">—</p>
      </div>
    </aside>

    <!-- ── 正文 ── -->
    <article class="post-main">
      <header class="post-header reveal">
        <div class="post-tags">
          {post.data.tags?.map((tag) => <span class="tag tag-platform">{tag}</span>)}
        </div>
        <h1 class="post-title">{post.data.title}</h1>
        <p class="post-lead">{post.data.description}</p>
        <div class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          <span class="dot"></span>
          <span>{readMinutes} 分钟读完</span>
        </div>
      </header>

      <div class="panel post-body">
        <div class="prose">
          <Content />
        </div>
      </div>

      <nav class="post-nav reveal">
        {prev ? (
          <a class="nav-card" href={`/posts/${prev.slug}`}>
            <span class="nav-label">← 上一篇</span>
            <span class="nav-title">{prev.data.title}</span>
          </a>
        ) : <span></span>}
        {next ? (
          <a class="nav-card is-next" href={`/posts/${next.slug}`}>
            <span class="nav-label">下一篇 →</span>
            <span class="nav-title">{next.data.title}</span>
          </a>
        ) : <span></span>}
      </nav>

      <div class="center-row">
        <a class="back-link" href="/posts">← 回到全部文章</a>
      </div>
    </article>
  </div>
</NekoLayout>

<script>
  /* ── 目录：点击跳转 + 滚动联动（scroll spy） ── */
  (function toc() {
    var links = Array.prototype.slice.call(document.querySelectorAll('.toc-item'));
    if (!links.length) return;

    var tocBox = document.querySelector('.sidebar-toc');

    /* 建立「目录项 ↔ 正文标题」的对应关系 */
    var targets = links
      .map(function (link) {
        var id = (link.getAttribute('href') || '').slice(1);
        return { link: link, el: id ? document.getElementById(id) : null };
      })
      .filter(function (t) { return t.el; });

    if (!targets.length) return;

    /* ── 点击平滑跳转 ── */
    links.forEach(function (link) {
      link.addEventListener('click', function (e) {
        var id = (link.getAttribute('href') || '').slice(1);
        var el = document.getElementById(id);
        if (!el) return;
        e.preventDefault();
        var top = el.getBoundingClientRect().top + window.scrollY - 104;
        window.scrollTo({ top: top, behavior: 'smooth' });
        history.replaceState(null, '', '#' + id);
      });
    });

    /* 标题在文档中的绝对位置，滚动时不必反复量取 */
    var tops = [];
    function measure() {
      tops = targets.map(function (t) {
        return t.el.getBoundingClientRect().top + window.scrollY;
      });
    }
    measure();
    window.addEventListener('resize', measure);
    window.addEventListener('load', measure);
    /* 网络字体是异步加载的，落地后高度可能微调，补测一次 */
    window.setTimeout(measure, 900);

    var current = -1;

    /* 高亮项若滚出目录可视区，把目录自己也滚一下 */
    function keepVisible(link) {
      if (!tocBox) return;
      var lr = link.getBoundingClientRect();
      var tr = tocBox.getBoundingClientRect();
      var pad = 12;
      var next = null;

      if (lr.top < tr.top + pad) {
        next = tocBox.scrollTop - (tr.top + pad - lr.top);
      } else if (lr.bottom > tr.bottom - pad) {
        next = tocBox.scrollTop + (lr.bottom - (tr.bottom - pad));
      }
      if (next !== null) {
        tocBox.scrollTo({ top: Math.max(0, next), behavior: 'smooth' });
      }
    }

    function setActive(i) {
      if (i === current) return;
      current = i;
      targets.forEach(function (t, idx) {
        t.link.classList.toggle('is-current', idx === i);
      });
      if (i >= 0) keepVisible(targets[i].link);
    }

    /* 判定线取视口上方 130px：标题越过这条线就算「读到这里了」 */
    function pick() {
      var line = window.scrollY + 130;
      var idx = -1;
      for (var i = 0; i < tops.length; i++) {
        if (tops[i] <= line) idx = i;
        else break;
      }
      setActive(idx);
    }

    var ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(function () {
        pick();
        ticking = false;
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    pick();
  })();

  /* ── 把正文代码块包装成编辑器窗口：窗口点 + 语言 + 复制 ── */
  (function codeBlocks() {
    document.querySelectorAll('.prose pre').forEach(function (pre) {
      if (pre.parentElement && pre.parentElement.classList.contains('code-wrapper')) return;

      var wrapper = document.createElement('div');
      wrapper.className = 'code-wrapper';
      pre.parentNode.insertBefore(wrapper, pre);

      var bar = document.createElement('div');
      bar.className = 'code-bar';

      var dots = document.createElement('span');
      dots.className = 'code-dots';
      dots.setAttribute('aria-hidden', 'true');
      for (var i = 0; i < 3; i++) dots.appendChild(document.createElement('i'));
      bar.appendChild(dots);

      var raw = (pre.getAttribute('data-language') || '').trim();
      var label = document.createElement('span');
      label.className = 'code-lang';
      label.textContent = !raw || /^(plaintext|text|txt)$/i.test(raw) ? 'text' : raw;
      bar.appendChild(label);

      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy-btn';
      btn.textContent = '复制';
      btn.addEventListener('click', function () {
        var codeEl = pre.querySelector('code');
        var code = codeEl ? codeEl.textContent : pre.textContent;
        navigator.clipboard.writeText(code || '').then(function () {
          btn.textContent = '已复制';
          btn.classList.add('is-done');
          setTimeout(function () {
            btn.textContent = '复制';
            btn.classList.remove('is-done');
          }, 1800);
        }).catch(function () {
          if (window.__toast) window.__toast('复制失败，手动选一下吧');
        });
      });
      bar.appendChild(btn);

      wrapper.appendChild(bar);
      wrapper.appendChild(pre);
    });
  })();

  /* ── 侧栏更新日历 ── */
  (function calendar() {
    var panel = document.getElementById('calendarPanel');
    var titleEl = document.getElementById('calendar-title');
    var daysEl = document.getElementById('calendar-days');
    var footEl = document.getElementById('calendar-foot');
    if (!panel || !titleEl || !daysEl) return;

    /* 每篇文章的发布日期，由构建时注入 */
    var archive = [];
    try { archive = JSON.parse(panel.dataset.archive || '[]'); } catch (e) { archive = []; }

    var byDate = {};
    archive.forEach(function (a) {
      if (!a || !a.date) return;
      if (!byDate[a.date]) byDate[a.date] = [];
      byDate[a.date].push(a);
    });

    var today = new Date();
    var cursor = new Date(today.getFullYear(), today.getMonth(), 1);

    function pad2(n) { return ('0' + n).slice(-2); }

    function makeCell(day, y, m) {
      var key = y + '-' + pad2(m + 1) + '-' + pad2(day);
      var hits = byDate[key] || [];
      var isToday =
        y === today.getFullYear() && m === today.getMonth() && day === today.getDate();

      var cell = document.createElement('span');
      cell.className = 'cal-day';
      cell.textContent = String(day);

      if (hits.length) {
        cell.classList.add('has-post');
        cell.title = hits.map(function (h) { return h.title; }).join('\n');
      }
      if (isToday) cell.classList.add('is-today');

      if (hits.length) {
        cell.classList.add('is-link');
        cell.setAttribute('role', 'link');
        cell.setAttribute('tabindex', '0');
        cell.setAttribute('aria-label', key + ' 的更新：' + hits[0].title);

        var go = function () { window.location.href = '/posts/' + hits[0].slug + '/'; };
        cell.addEventListener('click', go);
        cell.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); }
        });
      }
      return cell;
    }

    function countInMonth(y, m) {
      var prefix = y + '-' + pad2(m + 1);
      var n = 0;
      Object.keys(byDate).forEach(function (k) {
        if (k.indexOf(prefix) === 0) n += byDate[k].length;
      });
      return n;
    }

    /* 最近有更新的那个月，用于「本月空着」时的跳转提示 */
    function latestMonth() {
      var keys = Object.keys(byDate).sort();
      if (!keys.length) return null;
      var p = keys[keys.length - 1].split('-');
      return { y: Number(p[0]), m: Number(p[1]) - 1, label: Number(p[1]) + ' 月' };
    }

    function render() {
      var y = cursor.getFullYear();
      var m = cursor.getMonth();
      titleEl.textContent = y + ' 年 ' + (m + 1) + ' 月';
      daysEl.innerHTML = '';

      var startDay = new Date(y, m, 1).getDay();
      var total = new Date(y, m + 1, 0).getDate();
      var i;

      for (i = 0; i < startDay; i++) {
        var blank = document.createElement('span');
        blank.className = 'cal-empty';
        daysEl.appendChild(blank);
      }
      for (i = 1; i <= total; i++) {
        daysEl.appendChild(makeCell(i, y, m));
      }

      if (footEl) {
        var n = countInMonth(y, m);
        if (n) {
          footEl.textContent = '本月 ' + n + ' 篇更新，点日期直接看';
          footEl.classList.remove('is-link');
          footEl.onclick = null;
          footEl.removeAttribute('title');
        } else {
          var latest = latestMonth();
          if (latest) {
            footEl.textContent = '本月还没更新 · 最近是 ' + latest.label;
            footEl.classList.add('is-link');
            footEl.title = '跳到 ' + latest.label;
            footEl.onclick = function () {
              cursor = new Date(latest.y, latest.m, 1);
              render();
            };
          } else {
            footEl.textContent = '还没有文章';
            footEl.classList.remove('is-link');
            footEl.onclick = null;
          }
        }
      }
    }

    function shift(delta) {
      cursor = new Date(cursor.getFullYear(), cursor.getMonth() + delta, 1);
      render();
    }

    var prevBtn = document.getElementById('prev-month-btn');
    var nextBtn = document.getElementById('next-month-btn');
    var todayBtn = document.getElementById('cal-today-btn');
    if (prevBtn) prevBtn.addEventListener('click', function () { shift(-1); });
    if (nextBtn) nextBtn.addEventListener('click', function () { shift(1); });
    if (todayBtn) todayBtn.addEventListener('click', function () {
      cursor = new Date(today.getFullYear(), today.getMonth(), 1);
      render();
    });

    render();
  })();
</script>

<style>
  .post-layout {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 44px;
    align-items: start;
    padding-top: 56px;
    padding-bottom: 96px;
  }

  /* ── 侧栏 ── */
  .post-sidebar {
    position: sticky;
    top: 104px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    /* 目录长了也不会把日历顶出屏幕：整个侧栏自己滚 */
    max-height: calc(100vh - 128px);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    padding-right: 4px;
  }
  .post-sidebar::-webkit-scrollbar { width: 6px; }
  .post-sidebar::-webkit-scrollbar-thumb {
    background: var(--line-2);
    border-radius: 999px;
  }
  .post-sidebar::-webkit-scrollbar-thumb:hover { background: var(--pink); }

  .toc-header {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    font-size: 13px; font-weight: 700; color: var(--ink-3);
    letter-spacing: .14em; margin-bottom: 14px;
  }
  .toc-header em {
    font-style: normal; font-family: var(--font-latin); font-size: 11px; font-weight: 800;
    padding: 2px 8px; border-radius: 999px;
    background: var(--pink-soft); color: var(--pink-deep); letter-spacing: 0;
  }
  .toc-list { display: flex; flex-direction: column; gap: 2px; }
  .toc-item {
    padding: 9px 12px; border-radius: 12px;
    font-size: 13.5px; line-height: 1.5; color: var(--ink-2);
    border-left: 2px solid transparent;
    transition: background-color .2s ease, color .2s ease, border-color .2s ease;
  }
  .toc-item:hover { background: var(--pink-soft); color: var(--pink-deep); border-left-color: var(--pink); }
  .toc-item.is-sub { padding-left: 24px; font-size: 12.5px; color: var(--ink-3); }

  /* 当前正在阅读的章节 —— 跟随页面滚动实时高亮 */
  .toc-item.is-current,
  .toc-item.is-sub.is-current {
    background: var(--pink-soft);
    color: var(--pink-deep);
    border-left-color: var(--pink-deep);
    font-weight: 600;
  }
  .toc-item.is-sub.is-current { border-left-color: var(--pink); }

  /* 长文可能有三四十个标题。目录必须限高 + 独立滚动，
     否则它会把下面的信息面板和日历整个顶出侧栏可视区 */
  .sidebar-toc {
    max-height: min(38vh, 340px);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }
  .sidebar-toc::-webkit-scrollbar { width: 6px; }
  .sidebar-toc::-webkit-scrollbar-thumb { background: var(--line-2); border-radius: 999px; }
  .sidebar-toc::-webkit-scrollbar-thumb:hover { background: var(--pink); }

  .info-row {
    display: flex; align-items: baseline; justify-content: space-between; gap: 12px;
    padding: 9px 0; border-bottom: 1px solid var(--line);
  }
  .info-row:last-child { border-bottom: 0; }
  .info-label { font-size: 12px; color: var(--ink-3); }
  .info-value { font-family: var(--font-latin); font-size: 13px; font-weight: 700; color: var(--ink); }

  /* ── 侧栏更新日历 ── */
  .sidebar-cal { display: flex; flex-direction: column; gap: 10px; }

  .cal-head {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
  }
  .cal-title {
    font-family: var(--font-latin); font-size: 13px; font-weight: 800;
    color: var(--ink); letter-spacing: .01em; white-space: nowrap;
  }
  .cal-actions { display: flex; align-items: center; gap: 3px; }
  .cal-nav {
    width: 24px; height: 24px; border-radius: 8px;
    display: grid; place-items: center;
    background: transparent; color: var(--ink-3);
    font-size: 15px; line-height: 1;
    transition: background-color .18s ease, color .18s ease;
  }
  .cal-nav:hover { background: var(--pink-soft); color: var(--pink-deep); }
  .cal-today {
    padding: 4px 9px; border-radius: 8px;
    background: var(--pink-soft); color: var(--pink-deep);
    font-size: 11px; font-weight: 700; white-space: nowrap;
    transition: background-color .18s ease, color .18s ease;
  }
  .cal-today:hover { background: var(--pink-deep); color: #fff; }

  .cal-week, .cal-days { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
  .cal-week span {
    text-align: center; font-size: 10px; color: var(--ink-3); padding-bottom: 3px;
  }
  .cal-week span:first-child,
  .cal-week span:last-child { color: var(--pink); }

  /* 日期格子由脚本动态创建，拿不到 data-astro-cid，必须用 :global 才吃得到样式 */
  :global(.cal-day) {
    position: relative;
    display: grid; place-items: center;
    height: 30px; border-radius: 9px;
    font-family: var(--font-latin); font-size: 12px;
    color: var(--ink-2);
    transition: background-color .16s ease, color .16s ease;
  }
  :global(.cal-day:hover) { background: var(--pink-soft); color: var(--pink-deep); }

  /* 有更新的日期：粉色加粗 + 下方小圆点，点一下就跳过去 */
  :global(.cal-day.has-post) { color: var(--pink-deep); font-weight: 700; }
  :global(.cal-day.has-post::after) {
    content: '';
    position: absolute; bottom: 3px; left: 50%;
    width: 4px; height: 4px; border-radius: 50%;
    background: var(--pink-deep);
    transform: translateX(-50%);
  }
  :global(.cal-day.is-link) { cursor: pointer; }

  /* 今天：跟按钮 / 标签同一套樱粉渐变 */
  :global(.cal-day.is-today) {
    background: linear-gradient(135deg, #F79AB8, var(--pink-deep));
    color: #fff;
    font-weight: 700;
    box-shadow: 0 4px 12px -2px rgba(228, 102, 143, .45);
  }
  :global(.cal-day.is-today:hover) {
    background: linear-gradient(135deg, #F79AB8, var(--pink-deep));
    color: #fff;
  }
  :global(.cal-day.is-today.has-post::after) { background: #fff; }
  :global(.cal-empty) { visibility: hidden; }

  .cal-foot {
    margin: 0; padding-top: 10px;
    border-top: 1px solid var(--line);
    font-size: 11px; color: var(--ink-3); text-align: center;
    transition: color .18s ease;
  }
  .cal-foot.is-link { cursor: pointer; color: var(--pink-deep); font-weight: 600; }
  .cal-foot.is-link:hover { color: var(--pink-dark); text-decoration: underline; text-underline-offset: 3px; }

  /* ── 正文 ── */
  .post-main { min-width: 0; }
  .post-header { margin-bottom: 28px; }
  .post-header .post-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
  .post-title {
    margin: 0 0 14px; font-size: clamp(26px, 3.2vw, 38px);
    line-height: 1.4; font-weight: 700; letter-spacing: -.01em;
  }
  .post-lead { margin: 0 0 18px; font-size: 16px; line-height: 1.8; color: var(--ink-2); }
  .post-meta {
    display: flex; align-items: center; gap: 12px;
    font-family: var(--font-latin); font-size: 13px; color: var(--ink-3);
  }
  .post-meta .dot { width: 4px; height: 4px; border-radius: 50%; background: var(--line-2); }

  .post-body { padding: 44px 52px; }

  /* ── 上一篇 / 下一篇 ── */
  .post-nav {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px; margin-top: 32px;
  }
  .nav-card {
    display: flex; flex-direction: column; gap: 8px;
    padding: 20px 24px; border-radius: 20px;
    background: var(--surface); border: 1px solid var(--line);
    box-shadow: var(--sh-card);
    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
  }
