---
import { getCollection } from 'astro:content';
import NekoLayout from '../../layouts/NekoLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const sorted = [...posts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return sorted.map((post, i) => ({
    params: { slug: post.slug },
    props: {
      post,
      prev: sorted[i + 1] ?? null,
      next: sorted[i - 1] ?? null,
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await post.render();

/* 目录：只取二三级标题，避免侧栏过长 */
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

/* 正文字数（去 Markdown 标记的粗略统计） */
const wordCount = (post.body ?? '')
  .replace(/```[\s\S]*?```/g, '')
  .replace(/[#>*`\-|\[\]()]/g, '')
  .replace(/\s/g, '').length;

const readMinutes = Math.max(1, Math.round(wordCount / 400));
---

<NekoLayout title={`${post.data.title} · 樱风工房`} description={post.data.description} active="posts">
  <div class="post-layout wrap">
    <!-- ── 侧栏 ── -->
    <aside class="post-sidebar">
      {toc.length > 0 && (
        <nav class="panel panel-tight sidebar-toc reveal" aria-label="文章目录">
          <div class="toc-header">目录</div>
          <div class="toc-list">
            {toc.map((h) => (
              <a class:list={['toc-item', { 'is-sub': h.depth === 3 }]} href={`#${h.slug}`}>{h.text}</a>
            ))}
          </div>
        </nav>
      )}

      <div class="panel panel-tight sidebar-info reveal">
        <div class="info-row">
          <span class="info-label">约</span>
          <span class="info-value">{wordCount} 字</span>
        </div>
        <div class="info-row">
          <span class="info-label">阅读</span>
          <span class="info-value">{readMinutes} 分钟</span>
        </div>
        <div class="info-row">
          <span class="info-label">发布</span>
          <span class="info-value">{post.data.pubDate.toLocaleDateString('zh-CN')}</span>
        </div>
      </div>

      <div class="panel panel-tight sidebar-cal reveal">
        <div class="cal-header">
          <button class="cal-nav" id="prev-month-btn" type="button" aria-label="上个月">‹</button>
          <span class="cal-title" id="calendar-title">—</span>
          <button class="cal-nav" id="next-month-btn" type="button" aria-label="下个月">›</button>
        </div>
        <div class="cal-week"><span>日</span><span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span>六</span></div>
        <div class="cal-days" id="calendar-days"></div>
      </div>
    </aside>

    <!-- ── 正文 ── -->
    <article class="post-main">
      <header class="post-header reveal">
        <div class="post-tags">
          {post.data.tags?.map((tag) => <span class="tag tag-platform">{tag}</span>)}
        </div>
        <h1 class="post-title">{post.data.title}</h1>
        <p class="post-lead">{post.data.description}</p>
        <div class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          <span class="dot"></span>
          <span>{readMinutes} 分钟读完</span>
        </div>
      </header>

      <div class="panel post-body">
        <div class="prose">
          <Content />
        </div>
      </div>

      <nav class="post-nav reveal">
        {prev ? (
          <a class="nav-card" href={`/posts/${prev.slug}`}>
            <span class="nav-label">← 上一篇</span>
            <span class="nav-title">{prev.data.title}</span>
          </a>
        ) : <span></span>}
        {next ? (
          <a class="nav-card is-next" href={`/posts/${next.slug}`}>
            <span class="nav-label">下一篇 →</span>
            <span class="nav-title">{next.data.title}</span>
          </a>
        ) : <span></span>}
      </nav>

      <div class="center-row">
        <a class="back-link" href="/posts">← 回到全部文章</a>
      </div>
    </article>
  </div>
</NekoLayout>

<script>
  /* ── 目录平滑滚动 ── */
  document.querySelectorAll('.toc-item').forEach(function (link) {
    link.addEventListener('click', function (e) {
      var href = link.getAttribute('href') || '';
      var target = document.getElementById(href.slice(1));
      if (!target) return;
      e.preventDefault();
      var top = target.getBoundingClientRect().top + window.scrollY - 104;
      window.scrollTo({ top: top, behavior: 'smooth' });
    });
  });

  /* ── 给正文代码块加复制按钮 ── */
  (function copyButtons() {
    document.querySelectorAll('.prose pre').forEach(function (pre) {
      if (pre.parentElement && pre.parentElement.classList.contains('code-wrapper')) return;

      var wrapper = document.createElement('div');
      wrapper.className = 'code-wrapper';
      pre.parentNode.insertBefore(wrapper, pre);
      wrapper.appendChild(pre);

      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy-btn';
      btn.textContent = '复制';
      btn.addEventListener('click', function () {
        var codeEl = pre.querySelector('code');
        var code = codeEl ? codeEl.textContent : pre.textContent;
        navigator.clipboard.writeText(code || '').then(function () {
          btn.textContent = '已复制';
          btn.classList.add('is-done');
          setTimeout(function () {
            btn.textContent = '复制';
            btn.classList.remove('is-done');
          }, 1800);
        }).catch(function () {
          if (window.__toast) window.__toast('复制失败，手动选一下吧');
        });
      });
      wrapper.appendChild(btn);
    });
  })();

  /* ── 侧栏日历 ── */
  (function calendar() {
    var titleEl = document.getElementById('calendar-title');
    var daysEl = document.getElementById('calendar-days');
    if (!titleEl || !daysEl) return;

    var today = new Date();
    var cursor = new Date(today.getFullYear(), today.getMonth(), 1);

    function render() {
      var y = cursor.getFullYear();
      var m = cursor.getMonth();
      titleEl.textContent = y + ' 年 ' + (m + 1) + ' 月';
      daysEl.innerHTML = '';

      var startDay = new Date(y, m, 1).getDay();
      var total = new Date(y, m + 1, 0).getDate();
      var i;
      var d;

      for (i = 0; i < startDay; i++) {
        var pad = document.createElement('span');
        pad.className = 'cal-empty';
        daysEl.appendChild(pad);
      }
      for (d = 1; d <= total; d++) {
        var el = document.createElement('span');
        el.className = 'cal-day';
        el.textContent = String(d);
        if (y === today.getFullYear() && m === today.getMonth() && d === today.getDate()) {
          el.classList.add('is-today');
        }
        daysEl.appendChild(el);
      }
    }

    var prevBtn = document.getElementById('prev-month-btn');
    var nextBtn = document.getElementById('next-month-btn');
    if (prevBtn) prevBtn.addEventListener('click', function () {
      cursor = new Date(cursor.getFullYear(), cursor.getMonth() - 1, 1);
      render();
    });
    if (nextBtn) nextBtn.addEventListener('click', function () {
      cursor = new Date(cursor.getFullYear(), cursor.getMonth() + 1, 1);
      render();
    });

    render();
  })();
</script>

<style>
  .post-layout {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 44px;
    align-items: start;
    padding-top: 56px;
    padding-bottom: 96px;
  }

  /* ── 侧栏 ── */
  .post-sidebar {
    position: sticky; top: 104px;
    display: flex; flex-direction: column; gap: 16px;
  }
  .sidebar-toc { max-height: calc(100vh - 220px); overflow-y: auto; }

  .toc-header {
    font-size: 13px; font-weight: 700; color: var(--ink-3);
    letter-spacing: .14em; margin-bottom: 14px;
  }
  .toc-list { display: flex; flex-direction: column; gap: 2px; }
  .toc-item {
    padding: 9px 12px; border-radius: 12px;
    font-size: 13.5px; line-height: 1.5; color: var(--ink-2);
    border-left: 2px solid transparent;
    transition: background-color .2s ease, color .2s ease, border-color .2s ease;
  }
  .toc-item:hover { background: var(--pink-soft); color: var(--pink-deep); border-left-color: var(--pink); }
  .toc-item.is-sub { padding-left: 24px; font-size: 12.5px; color: var(--ink-3); }

  .info-row {
    display: flex; align-items: baseline; justify-content: space-between; gap: 12px;
    padding: 9px 0; border-bottom: 1px solid var(--line);
  }
  .info-row:last-child { border-bottom: 0; }
  .info-label { font-size: 12px; color: var(--ink-3); }
  .info-value { font-family: var(--font-latin); font-size: 13px; font-weight: 700; color: var(--ink); }

  .cal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
  .cal-title { font-family: var(--font-latin); font-size: 13px; font-weight: 700; }
  .cal-nav {
    width: 30px; height: 30px; border-radius: 10px;
    background: var(--pink-soft); color: var(--pink-deep); font-size: 16px; line-height: 1;
    transition: transform .2s ease, background-color .2s ease;
  }
  .cal-nav:hover { background: var(--pink); color: #fff; transform: scale(1.08); }
  .cal-week, .cal-days { display: grid; grid-template-columns: repeat(7, 1fr); gap: 3px; }
  .cal-week span { text-align: center; font-size: 11px; color: var(--ink-3); padding: 4px 0; }

  /* 日期格子由脚本动态创建，拿不到 data-astro-cid，必须用 :global 才吃得到样式 */
  :global(.cal-day) {
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    font-family: var(--font-latin);
    font-size: 12px;
    color: var(--ink-2);
    border-radius: 10px;
    transition: background-color .18s ease, color .18s ease, box-shadow .18s ease;
  }
  :global(.cal-day:hover) { background: var(--pink-soft); color: var(--pink-deep); }

  /* 今天：跟按钮 / 标签同一套樱粉渐变 */
  :global(.cal-day.is-today) {
    background: linear-gradient(135deg, #F79AB8, var(--pink-deep));
    color: #fff;
    font-weight: 700;
    box-shadow: 0 4px 12px -2px rgba(228, 102, 143, .45);
  }
  :global(.cal-day.is-today:hover) {
    background: linear-gradient(135deg, #F79AB8, var(--pink-deep));
    color: #fff;
  }
  :global(.cal-empty) { visibility: hidden; }

  /* ── 正文 ── */
  .post-main { min-width: 0; }
  .post-header { margin-bottom: 28px; }
  .post-header .post-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
  .post-title {
    margin: 0 0 14px; font-size: clamp(26px, 3.2vw, 38px);
    line-height: 1.4; font-weight: 700; letter-spacing: -.01em;
  }
  .post-lead { margin: 0 0 18px; font-size: 16px; line-height: 1.8; color: var(--ink-2); }
  .post-meta {
    display: flex; align-items: center; gap: 12px;
    font-family: var(--font-latin); font-size: 13px; color: var(--ink-3);
  }
  .post-meta .dot { width: 4px; height: 4px; border-radius: 50%; background: var(--line-2); }

  .post-body { padding: 44px 52px; }

  /* ── 上一篇 / 下一篇 ── */
  .post-nav {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px; margin-top: 32px;
  }
  .nav-card {
    display: flex; flex-direction: column; gap: 8px;
    padding: 20px 24px; border-radius: 20px;
    background: var(--surface); border: 1px solid var(--line);
    box-shadow: var(--sh-card);
    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
  }
  .nav-card:hover { transform: translateY(-4px); box-shadow: var(--sh-card-hover); border-color: rgba(243, 137, 174, .4); }
  .nav-card.is-next { text-align: right; }
  .nav-label { font-size: 12px; color: var(--pink-deep); font-weight: 600; }
  .nav-title { font-size: 15px; font-weight: 700; line-height: 1.5; }
  .post-nav .center-row { grid-column: 1 / -1; }

  .center-row { display: flex; justify-content: center; margin-top: 40px; }

  @media (max-width: 1024px) {
    .post-layout { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .post-sidebar {
      position: static;
      flex-direction: row; flex-wrap: wrap;
    }
    .post-sidebar > * { flex: 1 1 240px; }
    .sidebar-toc { max-height: none; }
    .post-body { padding: 28px 24px; }
  }
  @media (max-width: 640px) {
    .post-nav { grid-template-columns: minmax(0, 1fr); }
    .nav-card.is-next { text-align: left; }
  }
</style>
