          <circle cx="80" cy="66" r="38"></circle>
          <circle cx="142" cy="52" r="46"></circle>
          <circle cx="208" cy="68" r="34"></circle>
          <rect x="42" y="64" width="200" height="42" rx="21"></rect>
        </g>
      </svg>
      <span class="petal p1"></span>
      <span class="petal p2"></span>
