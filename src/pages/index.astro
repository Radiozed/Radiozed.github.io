  <script>
    /* ── 驱动库筛选 ── */
    (function filter() {
      const chips = document.querySelectorAll<HTMLElement>('.chip[data-filter]');
      const cards = document.querySelectorAll<HTMLElement>('#cardGrid .card');
      const empty = document.getElementById('gridEmpty');
      if (!chips.length) return;

      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const key = chip.dataset.filter ?? 'all';
          chips.forEach((c) => {
            const on = c === chip;
            c.classList.toggle('is-active', on);
            c.setAttribute('aria-pressed', String(on));
          });

          let shown = 0;
          cards.forEach((card) => {
            const tags = card.dataset.tags ?? '';
            const match = key === 'all' || tags.split(' ').includes(key);
            card.classList.toggle('is-hidden', !match);
            if (match) shown++;
          });
          if (empty) empty.hidden = shown > 0;
        });
      });
    })();
  </script>

