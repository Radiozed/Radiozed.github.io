---
import { getCollection } from 'astro:content';
import NekoLayout from '../layouts/NekoLayout.astro';
import { platformOf, categoryOf, busOf, tintOf, shortDate, uniqBy } from '../lib/classify';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

type Post = (typeof posts)[number];

/* ── 统一成一种卡片结构，已发布的和整理中的走同一套分类 ── */
interface Entry {
  kind: 'post' | 'planned';
  title: string;
  desc: string;
  platform: string;
  category: string;
  bus: string;
  difficulty: string;
  href?: string;
  meta: string;
}

const postEntries: Entry[] = posts.map((p) => ({
  kind: 'post',
  title: p.data.title,
  desc: p.data.description,
  platform: platformOf(p.data),
  category: categoryOf(p.data),
  bus: busOf(p.data),
  difficulty: p.data.difficulty ?? '进阶',
  href: `/posts/${p.slug}`,
  meta: `${busOf(p.data)} · ${p.data.pubDate.toLocaleDateString('zh-CN')} · 更新于 ${shortDate(p.data.pubDate)}`,
}));

/* ── 整理中的模块（还没写成文章的） ── */
const plannedEntries: Entry[] = [
  {
    kind: 'planned',
    title: 'SX1278 LoRa 无线模块',
    desc: '433MHz 远距离透传，包含寄存器配置、中断收发与低功耗休眠流程，两块板就能跑通。',
    platform: 'ESP32',
    category: '通信',
    bus: 'SPI',
    difficulty: '硬核',
    meta: 'SPI · 图文还在整理，先把接线跑通了',
  },
  {
    kind: 'planned',
    title: 'W25Q64 SPI Flash',
    desc: '8MB 串行 Flash，带扇区擦写、页编程与简易磨损均衡的工程封装。',
    platform: 'STM32',
    category: '存储',
    bus: 'SPI',
    difficulty: '进阶',
    meta: 'SPI · 图文还在整理，先把接线跑通了',
  },
  {
    kind: 'planned',
    title: 'AHT20 温湿度传感器',
    desc: '出厂校准的温湿度一体传感器，含 CRC 校验与浮点换算公式推导。',
    platform: '通用',
    category: '传感器',
    bus: 'I2C',
    difficulty: '入门',
    meta: 'I2C · 图文还在整理，先把接线跑通了',
  },
  {
    kind: 'planned',
    title: 'SSD1306 OLED 显示屏',
    desc: '0.96 寸 OLED，两线驱动，内置中英文字库与绘图 API，附取模工具。',
    platform: 'STM32',
    category: '显示',
    bus: 'I2C',
    difficulty: '入门',
    meta: 'I2C · 图文还在整理，先把接线跑通了',
  },
];

const entries: Entry[] = [...postEntries, ...plannedEntries];

/* ── 按数据算出分组，不写死 ── */
const platformFacets = uniqBy(entries.map((e) => e.platform), 'platform');
const categoryFacets = uniqBy(entries.map((e) => e.category), 'category');

const countBy = (key: 'platform' | 'category', value: string) =>
  entries.filter((e) => e[key] === value).length;
---

<NekoLayout title="樱风工房 · 让每一颗芯片都听话" active="home">
  <!-- ══════════ 首屏 ══════════ -->
  <section class="hero">
    <div class="hero-deco" aria-hidden="true">
      <span class="blob blob-pink"></span>
      <span class="blob blob-blue"></span>
      <span class="blob blob-lavender"></span>
      <svg class="cloud" viewBox="0 0 300 120" fill="none">
        <g fill="#fff" opacity=".85">
          <circle cx="80" cy="66" r="38"></circle>
          <circle cx="142" cy="52" r="46"></circle>
          <circle cx="208" cy="68" r="34"></circle>
          <rect x="42" y="64" width="200" height="42" rx="21"></rect>
        </g>
      </svg>
      <span class="petal p1"></span>
      <span class="petal p2"></span>
      <span class="petal p3"></span>
    </div>

    <div class="hero-row">
      <div class="hero-copy">
        <span class="badge reveal">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" aria-hidden="true">
            <path d="M12 2l2.2 6.3L20.5 10l-6.3 2.2L12 18.5 9.8 12.2 3.5 10l6.3-1.7L12 2Z" fill="var(--pink-deep)"></path>
          </svg>
          {posts.length} 篇驱动笔记 · 持续更新中
        </span>

        <h1 class="hero-title reveal">
          <span class="line">让每一颗芯片</span>
          <span class="line accent">都听话</span>
        </h1>

        <p class="hero-sub reveal">
          这里整理了我写过的各类模块驱动：源码、接线图、初始化流程，以及第一个能跑通的 Demo。踩过的坑，都写进注释里了。
        </p>

        <div class="hero-cta reveal">
          <a class="btn btn-primary btn-lg" href="#library">
            浏览驱动库
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
              <path d="M5 12h13M12.5 5.5L19 12l-6.5 6.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
          <a class="btn btn-ghost btn-lg" href="#tutorial">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
              <rect x="3" y="4" width="18" height="16" rx="4" stroke="var(--pink-deep)" stroke-width="1.8"></rect>
              <path d="M10 9.2l5 2.8-5 2.8V9.2Z" fill="var(--pink-deep)"></path>
            </svg>
            快速上手
          </a>
        </div>

        <p class="hero-trust reveal">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" stroke="var(--lavender)" stroke-width="1.8"></rect>
            <path d="M8 12h8M12 8v8" stroke="var(--lavender)" stroke-width="1.8" stroke-linecap="round"></path>
          </svg>
          覆盖 STM32 / ESP32 / Linux · I2C · SPI · UART
        </p>
      </div>

      <div class="hero-visual reveal">
        <!-- 当前位置天气：定位走 IP，天气走 Open-Meteo，均为免密钥公开接口 -->
        <div class="weather-card" id="weatherCard">
          <span class="weather-icon" id="weatherIcon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="30" height="30" fill="none">
              <path d="M17.5 18.5h-10a4.2 4.2 0 0 1-.4-8.4A5.8 5.8 0 0 1 18.3 11.6a3.6 3.6 0 0 1-.8 6.9Z"
                    fill="#FFFFFF" stroke="#C9B8D8" stroke-width="1.2"></path>
            </svg>
          </span>
          <div class="weather-body">
            <p class="weather-temp" id="weatherTemp">--</p>
            <p class="weather-place" id="weatherPlace">定位中…</p>
          </div>
          <span class="weather-divider" aria-hidden="true"></span>
          <div class="weather-side">
            <p class="weather-time" id="weatherTime">--:--</p>
            <p class="weather-extra" id="weatherExtra"></p>
          </div>
        </div>

        <span class="sticker">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="10" fill="var(--mint-deep)"></circle>
            <path d="M7.6 12.3l3 3 5.8-6.2" stroke="#fff" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          编译通过 · 可直接烧录
        </span>

        <div class="code-window">
          <div class="code-titlebar">
            <span class="dots" aria-hidden="true"><i class="d-r"></i><i class="d-y"></i><i class="d-g"></i></span>
            <span class="code-filename">max31865_pt100.c</span>
            <button class="copy-btn" type="button" data-copy aria-label="复制代码">复制</button>
          </div>
          <pre class="code-body"><code><span class="ln"><span class="tk-pp">#include</span> <span class="tk-str">"max31865.h"</span></span>
<span class="ln"></span>
<span class="ln"><span class="tk-type">void</span> <span class="tk-fn">app_main</span>(<span class="tk-type">void</span>) {</span>
<span class="ln">    <span class="tk-fn">max31865_init</span>(&amp;spi1, <span class="tk-num">CS_PIN</span>);</span>
<span class="ln">    <span class="tk-fn">max31865_set_wires</span>(&amp;spi1, <span class="tk-num">WIRES_3</span>);</span>
<span class="ln"></span>
<span class="ln">    <span class="tk-type">for</span> (;;) {</span>
<span class="ln">        <span class="tk-type">float</span> t = <span class="tk-fn">max31865_read_temp</span>(&amp;spi1);</span>
<span class="ln">        <span class="tk-fn">printf</span>(<span class="tk-str">"PT100: %.2f C\r\n"</span>, t);</span>
<span class="ln">        <span class="tk-fn">HAL_Delay</span>(<span class="tk-num">500</span>);</span>
<span class="ln">    }</span>
<span class="ln">}</span></code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════ 驱动代码库 ══════════ -->
  <section class="section section-library" id="library">
    <div class="wrap">
      <header class="section-head reveal">
        <p class="eyebrow">01 / DRIVER LIBRARY</p>
        <h2 class="section-title">驱动代码库</h2>
        <p class="section-desc">每个模块都配好了源码、接线图与调用示例。挑一个，直接接进你的工程。</p>
      </header>

      <div class="filter-bar reveal">
        <div class="filter-row" data-group="platform">
          <span class="filter-label">平台</span>
          <button class="chip is-active" type="button" data-value="all" aria-pressed="true">
            全部 <em>{entries.length}</em>
          </button>
          {platformFacets.map((v) => (
            <button class="chip" type="button" data-value={v} aria-pressed="false">
              {v} <em>{countBy('platform', v)}</em>
            </button>
          ))}
        </div>

        <div class="filter-row" data-group="category">
          <span class="filter-label">类别</span>
          <button class="chip is-active" type="button" data-value="all" aria-pressed="true">
            全部 <em>{entries.length}</em>
          </button>
          {categoryFacets.map((v) => (
            <button class="chip" type="button" data-value={v} aria-pressed="false">
              {v} <em>{countBy('category', v)}</em>
            </button>
          ))}
        </div>
      </div>

      <div class="card-grid" id="cardGrid">
        {entries.map((item) =>
          item.kind === 'post' && item.href ? (
            <a
              class="card reveal"
              href={item.href}
              data-platform={item.platform}
              data-category={item.category}
            >
              <div class="card-top">
                <span class="tag tag-platform">{item.platform} · {item.category}</span>
                <span class="tag tag-live">已发布</span>
              </div>
              <span class:list={['icon-box', tintOf(item.category)]}><span>{item.bus}</span></span>
              <h3 class="card-title">{item.title}</h3>
              <p class="card-desc">{item.desc}</p>
              <p class="card-meta">难度 {item.difficulty} · {item.meta}</p>
              <div class="card-foot">
                <span class="card-link">阅读笔记</span>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
                  <path d="M5 12h13M12.5 5.5L19 12l-6.5 6.5" stroke="var(--pink-deep)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </div>
            </a>
          ) : (
            <article
              class="card is-planned reveal"
              data-platform={item.platform}
              data-category={item.category}
            >
              <div class="card-top">
                <span class="tag tag-platform">{item.platform} · {item.category}</span>
                <span class="tag tag-plan">整理中</span>
              </div>
              <span class:list={['icon-box', tintOf(item.category)]}><span>{item.bus}</span></span>
              <h3 class="card-title">{item.title}</h3>
              <p class="card-desc">{item.desc}</p>
              <p class="card-meta">难度 {item.difficulty} · {item.meta}</p>
              <div class="card-foot">
                <span class="card-link" style="color:var(--ink-3)">即将上线</span>
              </div>
            </article>
          )
        )}
      </div>

      <p class="grid-empty" id="gridEmpty" hidden>这个分类下暂时没有内容，再等等我。</p>

      <div class="center-row reveal">
        <a class="btn btn-outline" href="/posts">查看全部 {posts.length} 篇驱动笔记</a>
      </div>
    </div>
  </section>

  <!-- ══════════ 应用教程 ══════════ -->
  <section class="section section-tutorial" id="tutorial">
    <div class="wrap">
      <header class="section-head reveal">
        <p class="eyebrow">02 / GETTING STARTED</p>
        <h2 class="section-title">四步，把模块接进你的工程</h2>
        <p class="section-desc">不绕弯子：从接线到跑通，每一步都有对应的示例代码和踩坑提示。</p>
      </header>

      <ol class="steps">
        <li class="step reveal">
          <span class="step-num" style="--tint:#F389AE">01</span>
          <h3 class="step-title">接线</h3>
          <p class="step-desc">按接线图接好 VCC、GND 与信号线，留意上拉电阻与 3.3V / 5V 电平匹配。</p>
        </li>
        <li class="step reveal">
          <span class="step-num" style="--tint:#79BCF0">02</span>
          <h3 class="step-title">配置</h3>
          <p class="step-desc">打开对应外设时钟，配好引脚复用与通信参数，别漏了片选脚。</p>
        </li>
        <li class="step reveal">
          <span class="step-num" style="--tint:#B5A5F0">03</span>
          <h3 class="step-title">初始化</h3>
          <p class="step-desc">调用 xxx_init() 并检查返回值，读一次器件 ID 确认通信真的通了。</p>
        </li>
        <li class="step reveal">
          <span class="step-num" style="--tint:#2FA37F">04</span>
          <h3 class="step-title">应用</h3>
          <p class="step-desc">用现成 API 读数据、刷新显示或上报云端，参考文章里的最小例程。</p>
        </li>
      </ol>

      <div class="tutorial-body">
        <div class="panel wiring-card reveal">
          <h3 class="card-h3">接线参考 · I2C 通用接法</h3>
          <p class="card-sub">STM32F103 · I2C1 · 400kHz</p>

          <svg class="wiring-svg" viewBox="0 0 520 300" role="img"
               aria-label="STM32 与 OLED 模块的 I2C 接线示意图：VCC、GND、SCL、SDA 四根线">
            <defs>
              <linearGradient id="wbg" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#FBF7FE"></stop><stop offset="1" stop-color="#F3F8FF"></stop>
              </linearGradient>
            </defs>
            <rect width="520" height="300" fill="url(#wbg)"></rect>
            <rect x="34" y="74" width="176" height="156" rx="18" fill="#EAF4FF" stroke="#BFDDF7" stroke-width="1.5"></rect>
            <rect x="60" y="100" width="124" height="104" rx="10" fill="#D9EBFC" stroke="#AECFF2" stroke-width="1.2"></rect>
            <text x="122" y="150" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="14" font-weight="700" fill="#3B82C4">STM32F103</text>
            <text x="122" y="170" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="10" fill="#7FA9CE">C8T6</text>
            <g fill="#BFDDF7">
              <rect x="66" y="60" width="9" height="14" rx="4"></rect><rect x="86" y="60" width="9" height="14" rx="4"></rect>
              <rect x="106" y="60" width="9" height="14" rx="4"></rect><rect x="126" y="60" width="9" height="14" rx="4"></rect>
              <rect x="66" y="230" width="9" height="14" rx="4"></rect><rect x="86" y="230" width="9" height="14" rx="4"></rect>
              <rect x="106" y="230" width="9" height="14" rx="4"></rect><rect x="126" y="230" width="9" height="14" rx="4"></rect>
            </g>
            <circle cx="185" cy="216" r="5.5" fill="#2FA37F"></circle>
            <text x="44" y="256" font-family="Noto Sans SC, sans-serif" font-size="11" fill="#7FA9CE">主控板</text>

            <rect x="312" y="86" width="174" height="132" rx="16" fill="#2B2439"></rect>
            <rect x="328" y="102" width="142" height="100" rx="10" fill="#151021"></rect>
            <g opacity=".6">
              <circle cx="360" cy="132" r="7" fill="#9BE8CE"></circle><circle cx="384" cy="132" r="7" fill="#F7A8C6"></circle>
              <circle cx="408" cy="132" r="7" fill="#8FD3F7"></circle><circle cx="432" cy="132" r="7" fill="#F5C069"></circle>
              <rect x="344" y="156" width="110" height="7" rx="3.5" fill="#E9E3F4"></rect>
              <rect x="344" y="174" width="74" height="7" rx="3.5" fill="#887DA6"></rect>
            </g>
            <text x="399" y="240" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="12" fill="#A89EB6">从设备模块</text>
            <text x="399" y="257" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="10" fill="#C4BAD4">I2C · 3.3V</text>

            <path d="M210 104 C 262 104, 262 112, 312 112" stroke="#F389AE" stroke-width="3" fill="none" stroke-linecap="round"></path>
            <path d="M210 122 C 262 122, 262 134, 312 134" stroke="#2B2439" stroke-width="3" fill="none" stroke-linecap="round"></path>
            <path d="M210 140 C 262 140, 262 156, 312 156" stroke="#79BCF0" stroke-width="3" fill="none" stroke-linecap="round"></path>
            <path d="M210 158 C 262 158, 262 178, 312 178" stroke="#2FA37F" stroke-width="3" fill="none" stroke-linecap="round"></path>

            <g font-family="JetBrains Mono, monospace" font-size="10.5" font-weight="700">
              <text x="242" y="98" fill="#E4668F">3.3V</text>
              <text x="242" y="118" fill="#5B4C6E">GND</text>
              <text x="242" y="152" fill="#3B82C4">SCL</text>
              <text x="242" y="174" fill="#2FA37F">SDA</text>
            </g>
          </svg>

          <p class="wiring-pins">SDA → PB7 &nbsp; SCL → PB6 &nbsp; VCC → 3.3V &nbsp; GND → GND</p>
        </div>

        <div class="panel check-card reveal">
          <h3 class="card-h3">踩过的坑，都记在这里</h3>
          <p class="card-sub-lead">这些坑我都踩过一遍了，写在驱动注释里，也整理在这里。</p>
          <ul class="check-list">
            <li><span class="check-ico" aria-hidden="true"></span>I2C 上拉电阻别省，4.7kΩ 是常用值——省掉会偶发读不到 ACK。</li>
            <li><span class="check-ico" aria-hidden="true"></span>上电后先延时 100ms 再发命令，模块未稳时命令会被直接忽略。</li>
            <li><span class="check-ico" aria-hidden="true"></span>SPI 要按手册选对 CPOL / CPHA，模式错了读出来全是 0xFF。</li>
            <li><span class="check-ico" aria-hidden="true"></span>长杜邦线跑高速 SPI 会误码，超过 20cm 建议降频或换屏蔽线。</li>
            <li><span class="check-ico" aria-hidden="true"></span>PT100 三线制一定要接对补偿线，接成两线制会多出引线电阻误差。</li>
            <li><span class="check-ico" aria-hidden="true"></span>用 DMA 刷屏要等上一帧传完再改显存，否则画面会明显撕裂。</li>
          </ul>
          <a class="btn btn-ghost check-cta" href="/posts/max31865-pt100">
            看真实案例：STM32F103C8T6 + MAX31865 读 PT100
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" aria-hidden="true">
              <path d="M5 12h13M12.5 5.5L19 12l-6.5 6.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════ 关于我 ══════════ -->
  <section class="section section-about" id="about">
    <div class="wrap">
      <header class="section-head reveal">
        <p class="eyebrow">03 / ABOUT ME</p>
        <h2 class="section-title">写驱动的人，也写踩坑日记</h2>
      </header>

      <div class="about-body">
        <div class="portrait-card reveal">
          <div class="portrait-img">
            <img src="/nekomusume.jpg" alt="Radiozed 的头像" width="448" height="440" loading="lazy" data-lightbox />
          </div>
          <p class="portrait-name">Radiozed</p>
          <p class="portrait-handle">@Radiozed · 嵌入式开发 / 二次元</p>
          <span class="portrait-sticker" aria-hidden="true">
            <svg viewBox="0 0 40 40" width="62" height="62">
              <circle cx="20" cy="20" r="19" fill="var(--pink-soft)"></circle>
              <g fill="var(--pink)">
                <ellipse cx="20" cy="12" rx="4.6" ry="5.8"></ellipse>
                <ellipse cx="20" cy="12" rx="4.6" ry="5.8" transform="rotate(72 20 20)"></ellipse>
                <ellipse cx="20" cy="12" rx="4.6" ry="5.8" transform="rotate(144 20 20)"></ellipse>
                <ellipse cx="20" cy="12" rx="4.6" ry="5.8" transform="rotate(216 20 20)"></ellipse>
                <ellipse cx="20" cy="12" rx="4.6" ry="5.8" transform="rotate(288 20 20)"></ellipse>
              </g>
              <circle cx="20" cy="20" r="3.2" fill="var(--pink-deep)"></circle>
            </svg>
          </span>
        </div>

        <div class="about-copy">
          <p class="reveal">
