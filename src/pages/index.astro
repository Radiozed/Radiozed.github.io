          {posts.length} 篇驱动笔记 · 持续更新中
        </span>

        <h1 class="hero-title reveal">
          <span class="line">让每一颗芯片</span>
          <span class="line accent">都听话</span>
        </h1>

        <p class="hero-sub reveal">
          这里整理了我写过的各类模块驱动：源码、接线图、初始化流程，以及第一个能跑通的 Demo。踩过的坑，都写进注释里了。
        </p>

        <div class="hero-cta reveal">
          <a class="btn btn-primary btn-lg" href="#library">
            浏览驱动库
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
              <path d="M5 12h13M12.5 5.5L19 12l-6.5 6.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
          <a class="btn btn-ghost btn-lg" href="#tutorial">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
              <rect x="3" y="4" width="18" height="16" rx="4" stroke="var(--pink-deep)" stroke-width="1.8"></rect>
              <path d="M10 9.2l5 2.8-5 2.8V9.2Z" fill="var(--pink-deep)"></path>
            </svg>
            快速上手
          </a>
        </div>

        <p class="hero-trust reveal">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" stroke="var(--lavender)" stroke-width="1.8"></rect>
            <path d="M8 12h8M12 8v8" stroke="var(--lavender)" stroke-width="1.8" stroke-linecap="round"></path>
          </svg>
          覆盖 STM32 / ESP32 / Linux · I2C · SPI · UART
        </p>
      </div>

      <div class="hero-visual reveal">
        <span class="sticker">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="10" fill="var(--mint-deep)"></circle>
            <path d="M7.6 12.3l3 3 5.8-6.2" stroke="#fff" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          编译通过 · 可直接烧录
        </span>

        <div class="code-window">
          <div class="code-titlebar">
            <span class="dots" aria-hidden="true"><i class="d-r"></i><i class="d-y"></i><i class="d-g"></i></span>
            <span class="code-filename">max31865_pt100.c</span>
            <button class="copy-btn" type="button" data-copy aria-label="复制代码">复制</button>
          </div>
          <pre class="code-body"><code><span class="ln"><span class="tk-pp">#include</span> <span class="tk-str">"max31865.h"</span></span>
<span class="ln"></span>
<span class="ln"><span class="tk-type">void</span> <span class="tk-fn">app_main</span>(<span class="tk-type">void</span>) {</span>
<span class="ln">    <span class="tk-fn">max31865_init</span>(&amp;spi1, <span class="tk-num">CS_PIN</span>);</span>
<span class="ln">    <span class="tk-fn">max31865_set_wires</span>(&amp;spi1, <span class="tk-num">WIRES_3</span>);</span>
<span class="ln"></span>
<span class="ln">    <span class="tk-type">for</span> (;;) {</span>
<span class="ln">        <span class="tk-type">float</span> t = <span class="tk-fn">max31865_read_temp</span>(&amp;spi1);</span>
<span class="ln">        <span class="tk-fn">printf</span>(<span class="tk-str">"PT100: %.2f C\r\n"</span>, t);</span>
<span class="ln">        <span class="tk-fn">HAL_Delay</span>(<span class="tk-num">500</span>);</span>
<span class="ln">    }</span>
<span class="ln">}</span></code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════ 驱动代码库 ══════════ -->
  <section class="section section-library" id="library">
    <div class="wrap">
      <header class="section-head reveal">
        <p class="eyebrow">01 / DRIVER LIBRARY</p>
        <h2 class="section-title">驱动代码库</h2>
        <p class="section-desc">每个模块都配好了源码、接线图与调用示例。挑一个，直接接进你的工程。</p>
      </header>

      <div class="chips reveal" role="group" aria-label="筛选驱动">
        {filters.map((f, i) => (
          <button
            class:list={['chip', { 'is-active': i === 0 }]}
            type="button"
            data-filter={f.key}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {f.label}{f.count !== undefined && <> <em>{f.count}</em></>}
          </button>
        ))}
      </div>

      <div class="card-grid" id="cardGrid">
        {posts.map((post, i) => {
          const platform = platformOf(post.data.tags);
          const bus = busOf(post);
          const tagString = ['live', platform.toLowerCase(), ...(post.data.tags ?? []).map((t) => t.toLowerCase())].join(' ');
          return (
            <a class="card reveal" href={`/posts/${post.slug}`} data-tags={tagString}>
              <div class="card-top">
                <span class="tag tag-platform">{platform}</span>
                <span class="tag tag-live">已发布</span>
              </div>
              <span class:list={['icon-box', tintAt(i)]}><span>{bus}</span></span>
              <h3 class="card-title">{post.data.title}</h3>
              <p class="card-desc">{post.data.description}</p>
              <p class="card-meta">{bus} · {post.data.pubDate.toLocaleDateString('zh-CN')} · {shortDate(post.data.pubDate)}</p>
              <div class="card-foot">
                <span class="card-link">阅读笔记</span>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
                  <path d="M5 12h13M12.5 5.5L19 12l-6.5 6.5" stroke="var(--pink-deep)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </div>
            </a>
          );
        })}

        {planned.map((item, i) => (
          <article class="card is-planned reveal" data-tags={['planned', ...item.tags].join(' ')}>
            <div class="card-top">
              <span class="tag tag-platform">{item.platform}</span>
              <span class="tag tag-plan">整理中</span>
            </div>
            <span class:list={['icon-box', tintAt(i + posts.length)]}><span>{item.bus}</span></span>
            <h3 class="card-title">{item.title}</h3>
            <p class="card-desc">{item.desc}</p>
            <p class="card-meta">{item.bus} · 图文还在整理，先把接线跑通了</p>
            <div class="card-foot">
              <span class="card-link" style="color:var(--ink-3)">即将上线</span>
            </div>
          </article>
        ))}
      </div>

      <p class="grid-empty" id="gridEmpty" hidden>这个分类下暂时没有内容，再等等我。</p>

      <div class="center-row reveal">
        <a class="btn btn-outline" href="/posts">查看全部 {posts.length} 篇驱动笔记</a>
      </div>
    </div>
  </section>

  <!-- ══════════ 应用教程 ══════════ -->
  <section class="section section-tutorial" id="tutorial">
    <div class="wrap">
      <header class="section-head reveal">
        <p class="eyebrow">02 / GETTING STARTED</p>
        <h2 class="section-title">四步，把模块接进你的工程</h2>
        <p class="section-desc">不绕弯子：从接线到跑通，每一步都有对应的示例代码和踩坑提示。</p>
      </header>

      <ol class="steps">
        <li class="step reveal">
          <span class="step-num" style="--tint:#F389AE">01</span>
          <h3 class="step-title">接线</h3>
          <p class="step-desc">按接线图接好 VCC、GND 与信号线，留意上拉电阻与 3.3V / 5V 电平匹配。</p>
        </li>
        <li class="step reveal">
          <span class="step-num" style="--tint:#79BCF0">02</span>
          <h3 class="step-title">配置</h3>
          <p class="step-desc">打开对应外设时钟，配好引脚复用与通信参数，别漏了片选脚。</p>
        </li>
        <li class="step reveal">
          <span class="step-num" style="--tint:#B5A5F0">03</span>
          <h3 class="step-title">初始化</h3>
          <p class="step-desc">调用 xxx_init() 并检查返回值，读一次器件 ID 确认通信真的通了。</p>
        </li>
        <li class="step reveal">
          <span class="step-num" style="--tint:#2FA37F">04</span>
          <h3 class="step-title">应用</h3>
          <p class="step-desc">用现成 API 读数据、刷新显示或上报云端，参考文章里的最小例程。</p>
        </li>
      </ol>

      <div class="tutorial-body">
        <div class="panel wiring-card reveal">
          <h3 class="card-h3">接线参考 · I2C 通用接法</h3>
          <p class="card-sub">STM32F103 · I2C1 · 400kHz</p>

          <svg class="wiring-svg" viewBox="0 0 520 300" role="img"
               aria-label="STM32 与 OLED 模块的 I2C 接线示意图：VCC、GND、SCL、SDA 四根线">
            <defs>
              <linearGradient id="wbg" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#FBF7FE"></stop><stop offset="1" stop-color="#F3F8FF"></stop>
              </linearGradient>
            </defs>
            <rect width="520" height="300" fill="url(#wbg)"></rect>
            <rect x="34" y="74" width="176" height="156" rx="18" fill="#EAF4FF" stroke="#BFDDF7" stroke-width="1.5"></rect>
            <rect x="60" y="100" width="124" height="104" rx="10" fill="#D9EBFC" stroke="#AECFF2" stroke-width="1.2"></rect>
            <text x="122" y="150" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="14" font-weight="700" fill="#3B82C4">STM32F103</text>
            <text x="122" y="170" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="10" fill="#7FA9CE">C8T6</text>
            <g fill="#BFDDF7">
              <rect x="66" y="60" width="9" height="14" rx="4"></rect><rect x="86" y="60" width="9" height="14" rx="4"></rect>
              <rect x="106" y="60" width="9" height="14" rx="4"></rect><rect x="126" y="60" width="9" height="14" rx="4"></rect>
              <rect x="66" y="230" width="9" height="14" rx="4"></rect><rect x="86" y="230" width="9" height="14" rx="4"></rect>
              <rect x="106" y="230" width="9" height="14" rx="4"></rect><rect x="126" y="230" width="9" height="14" rx="4"></rect>
            </g>
            <circle cx="185" cy="216" r="5.5" fill="#2FA37F"></circle>
            <text x="44" y="256" font-family="Noto Sans SC, sans-serif" font-size="11" fill="#7FA9CE">主控板</text>

            <rect x="312" y="86" width="174" height="132" rx="16" fill="#2B2439"></rect>
            <rect x="328" y="102" width="142" height="100" rx="10" fill="#151021"></rect>
            <g opacity=".6">
              <circle cx="360" cy="132" r="7" fill="#9BE8CE"></circle><circle cx="384" cy="132" r="7" fill="#F7A8C6"></circle>
              <circle cx="408" cy="132" r="7" fill="#8FD3F7"></circle><circle cx="432" cy="132" r="7" fill="#F5C069"></circle>
              <rect x="344" y="156" width="110" height="7" rx="3.5" fill="#E9E3F4"></rect>
