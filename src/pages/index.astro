---
import { getCollection } from 'astro:content';
import NekoLayout from '../layouts/NekoLayout.astro';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

/* ── 从文章的 tags 里推断平台与接口，不写死 ── */
const PLATFORMS = ['STM32', 'STM32F103C8T6', 'ESP32', 'Linux', '树莓派', 'Arduino', 'GD32'];
const platformOf = (tags: string[] = []) => tags.find((t) => PLATFORMS.includes(t)) ?? '通用';

const BUS_RULES: Array<[RegExp, string]> = [
  [/MAX31865|SPI/i, 'SPI'],
  [/I2C|OLED|SSD1306/i, 'I2C'],
  [/MQTT|OneNET/i, 'MQTT'],
  [/UART|串口/i, 'UART'],
  [/PT100/i, 'PT100'],
];
function busOf(post: (typeof posts)[number]) {
  const hay = [...(post.data.tags ?? []), post.data.title, post.data.description].join(' ');
  for (const [re, label] of BUS_RULES) if (re.test(hay)) return label;
  return 'NOTE';
}

const TINTS = ['tint-pink', 'tint-blue', 'tint-lavender', 'tint-mint', 'tint-amber'];
const tintAt = (i: number) => TINTS[i % TINTS.length];

const shortDate = (d: Date) => {
  const diff = Date.now() - d.valueOf();
  const day = 86400000;
  if (diff < day * 30) return `更新于 ${Math.max(1, Math.round(diff / day))} 天前`;
  if (diff < day * 365) return `更新于 ${Math.round(diff / (day * 30))} 个月前`;
  return `更新于 ${d.toLocaleDateString('zh-CN')}`;
};

/* ── 整理中的模块（还没写成文章的） ── */
const planned = [
  {
    title: 'SX1278 LoRa 无线模块',
    desc: '433MHz 远距离透传，包含寄存器配置、中断收发与低功耗休眠流程，两块板就能跑通。',
    platform: 'ESP32',
    bus: 'SPI',
    tags: ['esp32', '通信', 'spi'],
  },
  {
    title: 'W25Q64 SPI Flash',
    desc: '8MB 串行 Flash，带扇区擦写、页编程与简易磨损均衡的工程封装。',
    platform: 'STM32',
    bus: 'SPI',
    tags: ['stm32', '存储', 'spi'],
  },
  {
    title: 'AHT20 温湿度传感器',
    desc: '出厂校准的温湿度一体传感器，含 CRC 校验与浮点换算公式推导。',
    platform: '通用',
    bus: 'I2C',
    tags: ['传感器', 'i2c'],
  },
];

const filters = [
  { key: 'all', label: '全部', count: posts.length + planned.length },
  { key: 'live', label: '已发布', count: posts.length },
  { key: 'planned', label: '整理中', count: planned.length },
  { key: 'stm32', label: 'STM32' },
  { key: 'esp32', label: 'ESP32' },
  { key: 'sensor', label: '传感器' },
  { key: 'comm', label: '通信' },
];
---

