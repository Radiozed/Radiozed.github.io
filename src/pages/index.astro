  <script>
    /* ── 驱动库筛选：平台 × 类别，两个维度叠加生效 ── */
    (function filters() {
      var rows = document.querySelectorAll('.filter-row');
      var cards = document.querySelectorAll('#cardGrid .card');
      var empty = document.getElementById('gridEmpty');
      if (!rows.length || !cards.length) return;

      var state = { platform: 'all', category: 'all' };

      function apply() {
        var shown = 0;
        cards.forEach(function (card) {
          var ok =
            (state.platform === 'all' || card.dataset.platform === state.platform) &&
            (state.category === 'all' || card.dataset.category === state.category);
          card.classList.toggle('is-hidden', !ok);
          if (ok) shown++;
        });
        if (empty) empty.hidden = shown > 0;
      }

      rows.forEach(function (row) {
        var group = row.dataset.group;
        row.addEventListener('click', function (e) {
          var chip = e.target.closest('.chip');
          if (!chip) return;
          state[group] = chip.dataset.value;

          row.querySelectorAll('.chip').forEach(function (c) {
            var on = c === chip;
            c.classList.toggle('is-active', on);
            c.setAttribute('aria-pressed', String(on));
          });
          apply();
        });
      });
    })();

    /* ══════════ 当前位置天气 ══════════
       定位：ipwho.is → ipinfo.io → ipwhois.app，逐个失败就换下一个
       天气：Open-Meteo（免密钥公开接口）
       结果缓存 30 分钟，避免每次进首页都打接口 */
    (function weather() {
      var card = document.getElementById('weatherCard');
      if (!card) return;

      var elIcon = document.getElementById('weatherIcon');
      var elTemp = document.getElementById('weatherTemp');
      var elPlace = document.getElementById('weatherPlace');
      var elExtra = document.getElementById('weatherExtra');
      var elTime = document.getElementById('weatherTime');

      var CACHE_KEY = 'skz_weather_v2';
      var CACHE_TTL = 30 * 60 * 1000;

      /* WMO 天气码 → [中文描述, 图标名] */
      var WMO = {
        0: ['晴', 'sun'], 1: ['晴间多云', 'cloud-sun'], 2: ['多云', 'cloud-sun'], 3: ['阴', 'cloud'],
        45: ['有雾', 'fog'], 48: ['雾凇', 'fog'],
        51: ['毛毛雨', 'drizzle'], 53: ['小雨', 'drizzle'], 55: ['中雨', 'rain'],
        56: ['冻毛毛雨', 'drizzle'], 57: ['冻雨', 'rain'],
        61: ['小雨', 'rain'], 63: ['中雨', 'rain'], 65: ['大雨', 'rain'],
        66: ['冻雨', 'rain'], 67: ['强冻雨', 'rain'],
        71: ['小雪', 'snow'], 73: ['中雪', 'snow'], 75: ['大雪', 'snow'], 77: ['雪粒', 'snow'],
        80: ['阵雨', 'rain'], 81: ['强阵雨', 'rain'], 82: ['暴雨', 'rain'],
        85: ['阵雪', 'snow'], 86: ['强阵雪', 'snow'],
        95: ['雷阵雨', 'thunder'], 96: ['雷暴伴冰雹', 'thunder'], 99: ['强雷暴冰雹', 'thunder']
      };

      var ICONS = {
        sun: '<circle cx="12" cy="12" r="4.4" fill="#F5B942"></circle><g stroke="#F5B942" stroke-width="1.8" stroke-linecap="round"><path d="M12 2.6v2.4M12 19v2.4M2.6 12h2.4M19 12h2.4M5.4 5.4l1.7 1.7M16.9 16.9l1.7 1.7M18.6 5.4l-1.7 1.7M7.1 16.9l-1.7 1.7"></path></g>',
        moon: '<path d="M20 14.2A8.4 8.4 0 1 1 9.8 4a6.8 6.8 0 0 0 10.2 10.2Z" fill="#B5A5F0"></path>',
        'cloud-sun': '<circle cx="9" cy="8.6" r="3.2" fill="#F5B942"></circle><path d="M17.5 19H8a4 4 0 0 1-.4-8A5.5 5.5 0 0 1 18 12.2a3.4 3.4 0 0 1-.5 6.8Z" fill="#FFFFFF" stroke="#C9B8D8" stroke-width="1.2"></path>',
        'cloud-moon': '<path d="M10 8.6A5.2 5.2 0 1 1 6.2 5.2a4.2 4.2 0 0 0 3.8 3.4Z" fill="#B5A5F0"></path><path d="M17.5 19H8a4 4 0 0 1-.4-8A5.5 5.5 0 0 1 18 12.2a3.4 3.4 0 0 1-.5 6.8Z" fill="#FFFFFF" stroke="#C9B8D8" stroke-width="1.2"></path>',
        cloud: '<path d="M17.5 18.5h-10a4.2 4.2 0 0 1-.4-8.4A5.8 5.8 0 0 1 18.3 11.6a3.6 3.6 0 0 1-.8 6.9Z" fill="#FFFFFF" stroke="#C9B8D8" stroke-width="1.2"></path>',
        fog: '<g stroke="#A9C4D8" stroke-width="1.8" stroke-linecap="round"><path d="M6 9.5h12M4.5 13h15M6 16.5h12"></path></g>',
        drizzle: '<path d="M17.5 14.5H7.5a3.8 3.8 0 0 1-.3-7.6A5.2 5.2 0 0 1 17.8 8a3.3 3.3 0 0 1-.3 6.5Z" fill="#FFFFFF" stroke="#C9B8D8" stroke-width="1.2"></path><g stroke="#79BCF0" stroke-width="1.7" stroke-linecap="round"><path d="M9 17v1.8M13 17v1.8M17 17v1.8"></path></g>',
        rain: '<path d="M17.5 14.2H7.5a3.8 3.8 0 0 1-.3-7.6A5.2 5.2 0 0 1 17.8 7.7a3.3 3.3 0 0 1-.3 6.5Z" fill="#FFFFFF" stroke="#C9B8D8" stroke-width="1.2"></path><g stroke="#79BCF0" stroke-width="1.9" stroke-linecap="round"><path d="M9 16.6l-1 3M13 16.6l-1 3M17 16.6l-1 3"></path></g>',
        snow: '<path d="M17.5 13.8H7.5a3.8 3.8 0 0 1-.3-7.6A5.2 5.2 0 0 1 17.8 7.3a3.3 3.3 0 0 1-.3 6.5Z" fill="#FFFFFF" stroke="#C9B8D8" stroke-width="1.2"></path><g fill="#8FD3F7"><circle cx="9" cy="17.4" r="1.2"></circle><circle cx="13" cy="19.4" r="1.2"></circle><circle cx="17" cy="17.4" r="1.2"></circle></g>',
        thunder: '<path d="M17.5 13.6H7.5a3.8 3.8 0 0 1-.3-7.6A5.2 5.2 0 0 1 17.8 7.1a3.3 3.3 0 0 1-.3 6.5Z" fill="#FFFFFF" stroke="#C9B8D8" stroke-width="1.2"></path><path d="M13.2 14.6l-3.2 4.2h2.8l-1 3.6 3.8-4.8h-2.8l.4-3Z" fill="#F5B942"></path>'
      };

      function paintIcon(name) {
        var path = ICONS[name] || ICONS.cloud;
        elIcon.innerHTML =
          '<svg viewBox="0 0 24 24" width="30" height="30" fill="none" aria-hidden="true">' + path + '</svg>';
      }

      function get(url, ms) {
        return new Promise(function (resolve, reject) {
          var ctl = typeof AbortController !== 'undefined' ? new AbortController() : null;
          var timer = setTimeout(function () { if (ctl) ctl.abort(); }, ms || 8000);
          fetch(url, ctl ? { signal: ctl.signal } : {})
            .then(function (r) { return r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status)); })
            .then(function (d) { clearTimeout(timer); resolve(d); })
            .catch(function (e) { clearTimeout(timer); reject(e); });
        });
      }

      /* ── 城市名转汉字 ──────────────────────────────
         三个定位源返回的都是英文/拼音（Shenzhen、Guangzhou…），
         这里用内置表转成汉字；表里没有就退回省份，再没有才保留原文。 */
      var CITY_CN = {
        beijing: '北京', shanghai: '上海', tianjin: '天津', chongqing: '重庆',
        shenzhen: '深圳', guangzhou: '广州', hangzhou: '杭州', nanjing: '南京',
        wuhan: '武汉', chengdu: '成都', xian: '西安', suzhou: '苏州',
        changsha: '长沙', zhengzhou: '郑州', dongguan: '东莞', foshan: '佛山',
        qingdao: '青岛', shenyang: '沈阳', dalian: '大连', xiamen: '厦门',
        fuzhou: '福州', jinan: '济南', hefei: '合肥', kunming: '昆明',
        nanning: '南宁', guiyang: '贵阳', taiyuan: '太原', shijiazhuang: '石家庄',
        harbin: '哈尔滨', changchun: '长春', nanchang: '南昌', lanzhou: '兰州',
        urumqi: '乌鲁木齐', hohhot: '呼和浩特', yinchuan: '银川', xining: '西宁',
        haikou: '海口', sanya: '三亚', lhasa: '拉萨',
        wuxi: '无锡', ningbo: '宁波', wenzhou: '温州', jiaxing: '嘉兴',
        shaoxing: '绍兴', jinhua: '金华', taizhou: '台州', huzhou: '湖州',
        zhoushan: '舟山', lishui: '丽水', quzhou: '衢州',
        zhuhai: '珠海', zhongshan: '中山', huizhou: '惠州', jiangmen: '江门',
        shantou: '汕头', zhanjiang: '湛江', zhaoqing: '肇庆', qingyuan: '清远',
        shaoguan: '韶关', meizhou: '梅州', shanwei: '汕尾', heyuan: '河源',
        yangjiang: '阳江', maoming: '茂名', chaozhou: '潮州', jieyang: '揭阳',
        yunfu: '云浮',
        changzhou: '常州', nantong: '南通', yangzhou: '扬州', xuzhou: '徐州',
        zhenjiang: '镇江', taizhou_js: '泰州', yancheng: '盐城', huaian: '淮安',
        lianyungang: '连云港', suqian: '宿迁',
        yantai: '烟台', weifang: '潍坊', zibo: '淄博', linyi: '临沂',
        jining: '济宁', taian: '泰安', weihai: '威海', rizhao: '日照',
        luoyang: '洛阳', kaifeng: '开封', xinxiang: '新乡', nanyang: '南阳',
        baoding: '保定', tangshan: '唐山', qinhuangdao: '秦皇岛', langfang: '廊坊',
        handan: '邯郸', cangzhou: '沧州',
        datong: '大同', baotou: '包头', ordos: '鄂尔多斯',
        mianyang: '绵阳', yibin: '宜宾', nanchong: '南充', luzhou: '泸州',
        zunyi: '遵义', liuzhou: '柳州', guilin: '桂林', beihai: '北海',
        ganzhou: '赣州', jiujiang: '九江', shangrao: '上饶',
        xiangyang: '襄阳', yichang: '宜昌', jingzhou: '荆州',
        zhuzhou: '株洲', yueyang: '岳阳', hengyang: '衡阳', changde: '常德',
        quanzhou: '泉州', zhangzhou: '漳州', putian: '莆田', ningde: '宁德',
        dali: '大理', lijiang: '丽江', guilin_cn: '桂林',
        yiwu: '义乌', ruian: '瑞安', wenshang: '汶上'
      };

      var REGION_CN = {
        guangdong: '广东', zhejiang: '浙江', jiangsu: '江苏', shandong: '山东',
        henan: '河南', sichuan: '四川', hubei: '湖北', hunan: '湖南',
        fujian: '福建', anhui: '安徽', hebei: '河北', shanxi: '山西',
        shaanxi: '陕西', liaoning: '辽宁', jilin: '吉林', heilongjiang: '黑龙江',
        jiangxi: '江西', yunnan: '云南', guizhou: '贵州', guangxi: '广西',
        gansu: '甘肃', qinghai: '青海', ningxia: '宁夏', xinjiang: '新疆',
        tibet: '西藏', xizang: '西藏', hainan: '海南', innermongolia: '内蒙古',
        neimenggu: '内蒙古', beijing: '北京', shanghai: '上海', tianjin: '天津',
        chongqing: '重庆', hongkong: '中国香港', macau: '中国澳门', taiwan: '中国台湾',
        'hongkongsar': '中国香港', 'macaosar': '中国澳门'
      };

      function cnKey(s) {
        return String(s || '')
          .toLowerCase()
          .replace(/[^a-z]/g, '')
          .replace(/(shi|city|province|sheng)$/, '');
      }

      function toCN(name) {
        var k = cnKey(name);
        if (!k) return '';
        return CITY_CN[k] || REGION_CN[k] || '';
      }

      var GEO = [
        {
          url: 'https://ipwho.is/',
          pick: function (d) {
            if (!d || d.success === false) throw new Error('ipwho.is 未识别');
            return { name: d.city || d.region, lat: d.latitude, lon: d.longitude };
          }
        },
        {
          url: 'https://ipinfo.io/json',
          pick: function (d) {
            var loc = String(d.loc || '').split(',');
            if (loc.length !== 2) throw new Error('ipinfo 无坐标');
            return { name: d.city || d.region, lat: Number(loc[0]), lon: Number(loc[1]) };
          }
        },
        {
          url: 'https://ipwhois.app/json/',
          pick: function (d) {
            return { name: d.city || d.region, lat: Number(d.latitude), lon: Number(d.longitude) };
          }
        }
      ];

      function locate(i) {
        i = i || 0;
        if (i >= GEO.length) return Promise.reject(new Error('全部定位源不可用'));
        var p = GEO[i];
        return get(p.url, 7000)
          .then(function (d) { return p.pick(d); })
          .catch(function () { return locate(i + 1); });
      }

      function render(d) {
        var info = WMO[d.code] || ['—', 'cloud'];
        var iconName = info[1];
        if (!d.isDay && iconName === 'sun') iconName = 'moon';
        if (!d.isDay && iconName === 'cloud-sun') iconName = 'cloud-moon';

        paintIcon(iconName);
        elTemp.textContent = d.temp + '°';
        elPlace.textContent = d.place || '当前位置';
        elExtra.textContent = info[0] + ' · 体感 ' + d.feels + '°';
      }

      function load() {
        locate()
          .then(function (loc) {
            var url =
              'https://api.open-meteo.com/v1/forecast?latitude=' + loc.lat +
              '&longitude=' + loc.lon +
              '&current=temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,is_day&timezone=auto';
            return get(url, 9000).then(function (w) {
              var c = w.current;
              return {
                place: toCN(loc.name) || loc.name,
                temp: Math.round(c.temperature_2m),
                feels: Math.round(c.apparent_temperature),
                code: c.weather_code,
                isDay: c.is_day === 1,
                ts: Date.now()
              };
            });
          })
          .then(function (out) {
            try { sessionStorage.setItem(CACHE_KEY, JSON.stringify(out)); } catch (e) { /* 忽略 */ }
            render(out);
          })
          .catch(function () {
            elTemp.textContent = '--';
            elPlace.textContent = '天气暂不可用';
            elExtra.textContent = '';
            paintIcon('cloud');
          });
      }

      /* 时钟 */
      function tick() {
        var d = new Date();
        elTime.textContent =
          ('0' + d.getHours()).slice(-2) + ':' + ('0' + d.getMinutes()).slice(-2);
      }
      tick();
      setInterval(tick, 15000);

      /* 先看缓存 */
      var cached = null;
      try {
        var raw = sessionStorage.getItem(CACHE_KEY);
        if (raw) {
          var o = JSON.parse(raw);
          if (o && o.ts && Date.now() - o.ts < CACHE_TTL) cached = o;
        }
      } catch (e) { /* 忽略 */ }

      if (cached) render(cached);
      else load();
    })();
  </script>

  <style>
    /* ── 首屏 ── */
    .hero { position: relative; overflow: hidden; background: var(--bg-soft); }
    .hero-deco { position: absolute; inset: 0; pointer-events: none; }
