---
import NekoLayout from '../layouts/NekoLayout.astro';

const works = [
  { src: '/gallery1.jpg', title: 'Nekomimi', caption: '猫耳少女' },
  { src: '/gallery2.jpg', title: 'Neko', caption: '可爱的猫娘' },
  { src: '/gallery3.jpg', title: 'Meow', caption: '喵' },
  { src: '/gallery4.jpg', title: 'Neko', caption: '二次元猫娘' },
];
---

<NekoLayout title="画廊 · 樱风工房" description="Radiozed 的二次元画作收藏。" active="gallery">
  <section class="gallery-page wrap">
    <header class="page-head">
      <p class="eyebrow">GALLERY · {works.length} 张</p>
      <h1 class="page-title">画廊</h1>
      <p class="page-subtitle">一些喜欢的二次元画作，点开可以看大图。</p>
    </header>

    <div class="gallery-grid">
      {works.map((work, i) => (
        <figure class="gallery-item reveal" style={`--delay:${i * 80}ms`}>
          <img src={work.src} alt={work.title} loading="lazy" />
          <figcaption class="gallery-overlay">
            <h3>{work.title}</h3>
            <p>~ {work.caption} ~</p>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="center-row">
      <a class="back-link" href="/">← 返回首页</a>
    </div>
  </section>
</NekoLayout>

<style>
  .gallery-page { padding-bottom: 96px; }

  .gallery-grid {
    display: grid; gap: 24px;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }

  .gallery-item {
    position: relative; margin: 0; overflow: hidden;
    border-radius: 26px; aspect-ratio: 3 / 4;
    background: var(--pink-soft);
    border: 1px solid var(--line);
    box-shadow: var(--sh-card);
    transition: transform .4s cubic-bezier(.2, .8, .3, 1), box-shadow .4s ease;
  }
  .gallery-item:hover { transform: translateY(-8px); box-shadow: var(--sh-card-hover); }

  .gallery-item img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform .6s cubic-bezier(.2, .8, .3, 1);
  }
  .gallery-item:hover img { transform: scale(1.07); }

  .gallery-overlay {
    position: absolute; left: 0; right: 0; bottom: 0;
    padding: 30px 22px 22px;
    background: linear-gradient(transparent, rgba(42, 35, 64, .9) 60%);
    transform: translateY(60px);
    transition: transform .45s cubic-bezier(.2, .8, .3, 1);
    text-align: center;
  }
  .gallery-item:hover .gallery-overlay,
  .gallery-item:focus-within .gallery-overlay { transform: translateY(0); }

  .gallery-overlay h3 {
    margin: 0 0 6px; font-size: 18px; font-weight: 700; color: #fff;
    text-shadow: 0 2px 14px rgba(228, 102, 143, .6);
  }
  .gallery-overlay p { margin: 0; font-size: 13px; color: rgba(255, 255, 255, .84); }

  .center-row { display: flex; justify-content: center; margin-top: 56px; }

  @media (max-width: 560px) {
    .gallery-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .gallery-overlay { padding: 20px 12px 14px; transform: none; }
    .gallery-overlay h3 { font-size: 15px; }
    .gallery-overlay p { font-size: 11px; }
  }
</style>
